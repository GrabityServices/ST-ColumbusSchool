<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Student Marks</title>

<style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }


        body {
            font-family: Arial, sans-serif;
            background: #f3f4f6;
            color: #1f2937;
            padding: 20px;
        }


        .container {
            width: min(1000px, 100%);
            margin: auto;
        }


        .card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 18px;

            box-shadow:
                0 4px 15px rgba(
                    0,
                    0,
                    0,
                    .05
                );
        }


        /* =========================
           HEADER
        ========================== */

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }


        h1 {
            font-size: 26px;
            margin-bottom: 6px;
        }


        h2 {
            font-size: 20px;
            margin-bottom: 6px;
        }


        .muted {
            color: #6b7280;
            font-size: 14px;
        }


        .admin {
            background: #f3f4f6;
            border: 1px solid #e5e7eb;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
        }


        /* =========================
           STUDENT INFO
        ========================== */

        .student-info {
            display: grid;
            grid-template-columns:
                repeat(4, 1fr);

            gap: 14px;
        }


        .info {
            border: 1px solid #e5e7eb;
            background: #fafafa;
            border-radius: 8px;
            padding: 14px;
        }


        .info span {
            display: block;
            color: #6b7280;
            font-size: 12px;
            margin-bottom: 6px;
        }


        .info strong {
            display: block;
            font-size: 15px;
            word-break: break-word;
        }


        /* =========================
           MARKS
        ========================== */

        .marks-grid {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 16px;
            margin-top: 20px;
        }


        .mark-field {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }


        .mark-field label {
            font-size: 14px;
            font-weight: 600;
        }


        .mark-field input {
            width: 100%;
            height: 44px;

            padding: 0 12px;

            border: 1px solid #d1d5db;
            border-radius: 7px;

            font-size: 15px;
            outline: none;

            text-align: center;
        }


        .mark-field input:focus {
            border-color: #2563eb;

            box-shadow:
                0 0 0 3px rgba(
                    37,
                    99,
                    235,
                    .1
                );
        }


        .mark-help {
            font-size: 11px;
            color: #6b7280;
        }


        /* =========================
           BUTTONS
        ========================== */

        .actions {
            margin-top: 28px;

            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }


        .btn {
            border: none;
            border-radius: 7px;
            padding: 12px 20px;

            font-size: 14px;
            font-weight: 600;

            cursor: pointer;
            text-decoration: none;
        }


        .btn-save {
            background: #2563eb;
            color: white;
        }


        .btn-save:hover {
            background: #1d4ed8;
        }


        .btn-back {
            background: #e5e7eb;
            color: #111827;
        }


        .btn-back:hover {
            background: #d1d5db;
        }


        /* =========================
           RESPONSIVE
        ========================== */

        @media (max-width: 850px) {

            .student-info {
                grid-template-columns:
                    repeat(2, 1fr);
            }


            .marks-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }

        }


        @media (max-width: 600px) {

            body {
                padding: 12px;
            }


            .card {
                padding: 18px;
            }


            .header {
                flex-direction: column;
                align-items: flex-start;
            }


            .student-info,
            .marks-grid {
                grid-template-columns: 1fr;
            }


            .actions {
                flex-direction: column-reverse;
            }


            .btn {
                width: 100%;
                text-align: center;
            }

        }


/* =========================================================
   OTP MODAL
========================================================= */

.otp-modal {

    position: fixed;

    inset: 0;

    display: none;

    align-items: center;

    justify-content: center;

    background: rgba(0, 0, 0, 0.65);

    z-index: 999999;

    padding: 20px;
}


.otp-modal.show {

    display: flex;
}


.otp-box {

    position: relative;

    width: 100%;

    max-width: 430px;

    background: #fff;

    border-radius: 14px;

    padding: 30px;

    box-shadow:
        0 20px 60px
        rgba(0, 0, 0, 0.3);
}


.otp-box h2 {

    margin: 0 0 12px;

    text-align: center;

    font-size: 24px;

}


.otp-description {

    margin-bottom: 25px;

    text-align: center;

    color: #666;

    font-size: 14px;

    line-height: 1.5;
}


.otp-box label {

    display: block;

    margin-bottom: 8px;

    font-weight: 600;
}


#otpInput {

    width: 100%;

    height: 58px;

    border: 2px solid #ddd;

    border-radius: 9px;

    outline: none;

    text-align: center;

    font-size: 28px;

    font-weight: 700;

    letter-spacing: 8px;
}


#otpInput:focus {

    border-color: #667eea;
}


#verifyOtpBtn {

    width: 100%;

    height: 50px;

    margin-top: 18px;

    border: none;

    border-radius: 8px;

    background: #667eea;

    color: white;

    font-size: 16px;

    font-weight: 600;

    cursor: pointer;
}


#verifyOtpBtn:disabled {

    opacity: 0.6;

    cursor: not-allowed;
}


.otp-message {

    min-height: 20px;

    margin-top: 10px;

    text-align: center;

    color: #d33;

    font-size: 14px;
}


.otp-expiry {

    margin-top: 15px;

    text-align: center;

    color: #888;

    font-size: 12px;
}


.otp-close {

    position: absolute;

    top: 8px;

    right: 10px;

    width: 35px;

    height: 35px;

    border: none;

    background: transparent;

    color: #777;

    font-size: 28px;

    cursor: pointer;
}

</style>



</head>

<body>

<div class="container">

    <div class="card header">
        <div>
            <h1>Edit Student Marks</h1>
            <p class="muted">
                Class <strong><%= className %></strong>
                &nbsp; | &nbsp;
                Examination <strong><%= examType %></strong>
            </p>
        </div>

        <div class="admin">
            Admin:
            <strong><%= admin?.uniqId || admin?.id || "-" %></strong>
            -
            <%= admin?.name || admin?.email || "-" %>
        </div>
    </div>


    <div class="card">

        <div class="student-info">

            <div class="info">
                <span>Student Name</span>
                <strong><%= student?.name || "-" %></strong>
            </div>

            <div class="info">
                <span>Admission Number</span>
                <strong><%= student?.admissionNumber || admissionNumber || "-" %></strong>
            </div>

            <div class="info">
                <span>Roll Number</span>
                <strong><%= student?.rollNumber ?? "-" %></strong>
            </div>

            <div class="info">
                <span>Examination</span>
                <strong><%= examType || "-" %></strong>
            </div>

        </div>

    </div>


    <form
        id="marksForm"
        class="card"
        method="POST"
        action="/marksheet/edit/<%= encodeURIComponent(String(student.admissionNumber || admissionNumber)) %>"
    >

        <input type="hidden" name="class" value="<%= className %>">
        <input type="hidden" name="examType" value="<%= examType %>">
        <input type="hidden" name="studentId" value="<%= admissionNumber %>">

        <h2>Examination Marks</h2>

        <p class="muted">
            Enter the marks for this examination and click Save Marks.
            OTP verification will be requested before the actual update.
        </p>


        <%
            /*
             * These names must match the subject fields in the marks model.
             * Existing values are loaded directly from the student document.
             */
            const subjects = [
                { key: "english",  label: "English" },
                { key: "hindi",    label: "Hindi" },
                { key: "math",     label: "Mathematics" },
                { key: "sst",      label: "Social Studies" },
                { key: "gsc",      label: "General Science" },
                { key: "gk",       label: "General Knowledge" },
                { key: "computer", label: "Computer" },
                { key: "language", label: "Lang (Sans/Urdu)" }
            ];

            const isPT =
                ["PT1", "PT2", "PT3", "PT4",
                 "Periodic-Test-1", "Periodic-Test-2",
                 "Periodic-Test-3", "Periodic-Test-4"]
                .includes(String(examType));

            const maxMarks = isPT ? 10 : 80;
        %>


        <div class="marks-grid">

            <% subjects.forEach(subject => { %>

                <div class="mark-field">

                    <label for="mark_<%= subject.key %>">
                        <%= subject.label %>
                    </label>

                    <input
                        id="mark_<%= subject.key %>"
                        name="<%= subject.key %>"
                        type="number"
                        min="0"
                        max="<%= maxMarks %>"
                        step="1"
                        inputmode="numeric"
                        value="<%= student?.[subject.key] ?? "" %>"
                        placeholder="0 - <%= maxMarks %>"
                    >

                    <div class="mark-help">
                        Maximum: <%= maxMarks %>
                    </div>

                </div>

            <% }) %>

        </div>


        <div class="actions">

            <a
                href="/marksheet"
                class="btn btn-back"
            >
                Back
            </a>

            <button
                id="saveMarksBtn"
                type="button"
                class="btn btn-save"
                onclick="saveMarks()"
            >
                Save Marks
            </button>

        </div>

    </form>

</div>


<!-- =========================================================
     OTP MODAL
========================================================= -->

<div id="otpModal" class="otp-modal">

    <div class="otp-box">

        <button
            type="button"
            class="otp-close"
            onclick="closeOTPModal()"
            aria-label="Close"
        >
            &times;
        </button>

        <h2>Verify Marks Editing</h2>

        <p class="otp-description">
            Enter the 6-digit OTP sent to the authorized security email.
        </p>

        <label for="otpInput">
            Verification Code
        </label>

        <input
            id="otpInput"
            type="text"
            maxlength="6"
            inputmode="numeric"
            autocomplete="one-time-code"
            placeholder="000000"
        >

        <p id="otpMessage" class="otp-message" role="alert"></p>

        <button
            id="verifyOtpBtn"
            type="button"
            onclick="verifyAndSave()"
        >
            Verify &amp; Save
        </button>

        <p class="otp-expiry">
            OTP expires in 5 minutes.
        </p>

    </div>

</div>


<script>

/* =========================================================
   STATE
========================================================= */

window.marksEditChallengeId = null;


/* =========================================================
   MARK VALIDATION
========================================================= */

document.querySelectorAll(
    '#marksForm input[type="number"]'
).forEach(function (input) {

    input.addEventListener("input", function () {

        if (this.value === "") {
            this.setCustomValidity("");
            return;
        }

        const value = Number(this.value);
        const max = Number(this.max);

        if (!Number.isFinite(value)) {
            this.setCustomValidity("Enter a valid number.");
        } else if (value < 0) {
            this.setCustomValidity("Marks cannot be negative.");
        } else if (value > max) {
            this.setCustomValidity(
                "Maximum marks are " + max + "."
            );
        } else {
            this.setCustomValidity("");
        }

    });

});


/* =========================================================
   FORM DATA
========================================================= */

function getMarksBody() {

    const form = document.getElementById("marksForm");

    if (!form) {
        throw new Error("Marks form not found.");
    }

    if (!form.checkValidity()) {
        form.reportValidity();
        return null;
    }

    return Object.fromEntries(
        new FormData(form).entries()
    );
}


/* =========================================================
   SAVE MARKS
========================================================= */

async function saveMarks() {

    const form = document.getElementById("marksForm");
    const button = document.getElementById("saveMarksBtn");

    if (!form) {
        alert("Marks form not found.");
        return;
    }

    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    const body = Object.fromEntries(
        new FormData(form).entries()
    );

    button.disabled = true;
    button.textContent = "Checking...";

    try {

        const response = await fetch(
            form.action,
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json, text/html"
                },
                body: JSON.stringify(body)
            }
        );


        /* -------------------------------------------------
           OTP CHALLENGE CREATED
        ------------------------------------------------- */

        if (response.status === 202) {

            let data = {};

            try {
                data = await response.json();
            } catch (e) {
                throw new Error(
                    "Server requested verification but returned invalid JSON."
                );
            }

           if (
    data.verificationRequired &&
    data.otpChallengeId
) {

    window.marksEditChallengeId =
        data.otpChallengeId;

    // Keep Save Marks disabled
    // while OTP modal is open.
    button.disabled = true;
    button.textContent = "OTP Required";

    openOTPModal();

    return;
}

            throw new Error(
                data.message ||
                "Verification was requested, but no OTP challenge was returned."
            );
        }


        /* -------------------------------------------------
           SUCCESS REDIRECT
        ------------------------------------------------- */

        if (
            response.redirected ||
            response.status >= 300 &&
            response.status < 400
        ) {

            window.location.href =
                response.url;

            return;
        }


        /* -------------------------------------------------
           NORMAL SUCCESS
        ------------------------------------------------- */

        if (response.ok) {

            const contentType =
                response.headers.get("content-type") || "";

            if (contentType.includes("application/json")) {

                const data =
                    await response.json();

                if (data.success) {

                    alert(
                        data.message ||
                        "Marks saved successfully."
                    );

                    if (data.redirect) {
                        window.location.href =
                            data.redirect;
                    }

                    return;
                }

            } else {

                const text =
                    await response.text();

                if (text) {
                    document.open();
                    document.write(text);
                    document.close();
                    return;
                }

            }
        }


        /* -------------------------------------------------
           SERVER ERROR
        ------------------------------------------------- */

        const contentType =
            response.headers.get("content-type") || "";

        let message =
            "Unable to save marks.";

        if (contentType.includes("application/json")) {

            const data =
                await response.json();

            message =
                data.message || message;

        } else {

            const text =
                await response.text();

            if (text.trim()) {
                message = text;
            }

        }

        throw new Error(message);


    } catch (error) {

        console.error(
            "Save marks error:",
            error
        );

        alert(
            error.message ||
            "Unable to save marks."
        );

    } finally {

        button.disabled = false;
        button.textContent = "Save Marks";

    }
}


/* =========================================================
   OPEN OTP
========================================================= */

function openOTPModal() {

    const modal =
        document.getElementById("otpModal");

    const input =
        document.getElementById("otpInput");

    const message =
        document.getElementById("otpMessage");

    const button =
        document.getElementById("verifyOtpBtn");

    modal.classList.add("show");

    input.value = "";
    message.textContent = "";

    button.disabled = false;
    button.textContent = "Verify & Save";

    setTimeout(function () {
        input.focus();
    }, 100);

}


/* =========================================================
   CLOSE OTP
========================================================= */

function closeOTPModal() {

    const modal =
        document.getElementById("otpModal");

    modal.classList.remove("show");

}


/* =========================================================
   VERIFY OTP + SAVE
========================================================= */

async function verifyAndSave() {

    const input =
        document.getElementById("otpInput");

    const message =
        document.getElementById("otpMessage");

    const button =
        document.getElementById("verifyOtpBtn");

    const form =
        document.getElementById("marksForm");


    const otp =
        input.value.trim();


    if (!/^\d{6}$/.test(otp)) {

        message.textContent =
            "Enter the 6-digit OTP.";

        input.focus();

        return;
    }


    if (!window.marksEditChallengeId) {

        message.textContent =
            "Verification session expired. Click Save Marks again.";

        return;
    }


    if (!form) {

        message.textContent =
            "Marks form not found.";

        return;
    }


    const body = Object.fromEntries(
        new FormData(form).entries()
    );


    body.otpChallengeId =
        window.marksEditChallengeId;

    body.otp = otp;


    button.disabled = true;
    button.textContent = "Verifying & Saving...";
    message.textContent = "";


    try {

        const response = await fetch(
            form.action,
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json, text/html"
                },
                body: JSON.stringify(body)
            }
        );


        /* -------------------------------------------------
           SUCCESS
        ------------------------------------------------- */

        if (response.redirected) {

            window.marksEditChallengeId = null;

            window.location.href =
                response.url;

            return;
        }


        if (response.ok) {

            const contentType =
                response.headers.get("content-type") || "";

            if (contentType.includes("application/json")) {

                const data =
                    await response.json();

                if (data.success) {

                    window.marksEditChallengeId = null;

                    if (data.redirect) {

                        window.location.href =
                            data.redirect;

                    } else {

                        closeOTPModal();

                        alert(
                            data.message ||
                            "Marks saved successfully."
                        );

                    }

                    return;
                }

                message.textContent =
                    data.message ||
                    "Unable to save marks.";

            } else {

                const text =
                    await response.text();

                if (text.trim()) {

                    document.open();
                    document.write(text);
                    document.close();

                    return;
                }

            }

        } else {

            const contentType =
                response.headers.get("content-type") || "";

            if (contentType.includes("application/json")) {

                const data =
                    await response.json();

                message.textContent =
                    data.message ||
                    "Invalid or expired OTP.";

            } else {

                const text =
                    await response.text();

                message.textContent =
                    text ||
                    "Invalid or expired OTP.";

            }

        }


    } catch (error) {

        console.error(
            "OTP verification error:",
            error
        );

        message.textContent =
            error.message ||
            "Unable to verify OTP.";

    } finally {

        button.disabled = false;
        button.textContent = "Verify & Save";

    }
}


/* =========================================================
   OTP: ONLY NUMBERS
========================================================= */

document.addEventListener(
    "input",
    function (event) {

        if (
            event.target &&
            event.target.id === "otpInput"
        ) {

            event.target.value =
                event.target.value
                    .replace(/\D/g, "")
                    .slice(0, 6);

        }

    }
);


/* =========================================================
   OTP: ENTER KEY
========================================================= */

document.addEventListener(
    "keydown",
    function (event) {

        if (
            event.target &&
            event.target.id === "otpInput" &&
            event.key === "Enter"
        ) {

            event.preventDefault();

            verifyAndSave();

        }

    }
);

</script>

</body>
</html>
