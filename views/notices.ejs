    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script src="https://cdn.jsdelivr.net/npm/typed.js@2.0.12"></script>

  <!-- CSS -->
  <link rel="stylesheet" href="/style/style.css" />
  <link rel="stylesheet" href="/style/notices.css" />
  <link rel="stylesheet" href="/style/footer.css" />
  <link rel="stylesheet" href="/style/animation.css" />

  <!-- JS SCRIPTS -->
  <script src="/script/script.js" defer></script>
  <script src="/script/notices.js" defer></script>
  <script src="/script/animation.js" defer></script>

  <!-- BREADCRUMB SCHEMA -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.stcolumbusekdara.cloud/"},
      {"@type": "ListItem", "position": 2, "name": "Notices", "item": "https://www.stcolumbusekdara.cloud/notice"}
    ]
  }
  </script>

  <!-- ORGANIZATION / SCHOOL SCHEMA -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "School",
    "name": "St. Columbus Public School",
    "url": "https://www.stcolumbusekdara.cloud/",
    "logo": "https://www.stcolumbusekdara.cloud/images/favicon_io/android-chrome-512x512.png",
    "sameAs": [
      "https://www.facebook.com/share/1H5Z3RhMEb/",
      "https://www.instagram.com/columbusschooljhajha",
      "https://www.youtube.com/@DilipKumar-rf4rx/videos",
      "https://x.com/stcolumbus2002"
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ekdara",
      "addressLocality": "Jhajha",
      "addressRegion": "Bihar",
      "postalCode": "811308",
      "addressCountry": "IN"
    },
    "telephone": "+918541083858",
    "email": "st.columbus2002@gmail.com"
  }
  </script>
  
</head>
<body>
    <!--HEADER  -->
    <%- include('index.ejs') %>

    <!-- HEADING -->
    <section class="notices-heading">
      <div class="notices-overlay"></div>
      <div class="notices-inner animate slide-in-bottom">
        <h1>Notices & Announcements</h1>
        <p class="subtitle">
          All latest school notices, circulars, exam schedules and urgent
          updates for parents and students.
        </p>
      </div>
    </section>

    <main>
      <!-- NOTICE CONTAINER -->
      <section class="notice-container ">
        <% if(notices && notices.length > 0){ notices.forEach((notice,idx)=>{ %>
        <div class="notice-card animate slide-in-top"style="border-color:<%= idx==0?"#0b6":"" %>">
          <h3><%= notice.title %></h3>
          <time datetime="<%= notice.messDate %>"><%= notice.messDate %></time>
          <p class="description"><%= notice.mess %></p><% if(notice && notice.img) {%>
            
          <!-- <a href="<%= notice.img  %>" download>See Notice</a> -->
          <a href="<%= notice.img %>" onclick="openAndDownload(event, this.href)">See Notice</a>
            <% } %>
        </div>
        <% }) } else { %>
        <h2 class="nboard">Notice board is empty!</h2>
        <% } %>
      </section>

      <!-- LOAD MORE BUTTON -->
      <section class="load-more">
        <% if(notices && notices.length>3){%>

        <button class="load-more-btn">Load More</button>
        <% } %>
      </section>
    </main>

    <!-- FOOTER -->
    <%- include('footer.ejs') %>

</body>
</html>
