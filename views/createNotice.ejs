<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Create New Notice</title>


  <style>

    /* =========================================================
       RESET
    ========================================================= */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family:
        'Gill Sans',
        'Gill Sans MT',
        Calibri,
        'Trebuchet MS',
        sans-serif;
    }


    /* =========================================================
       BODY
    ========================================================= */

    body {

      min-height: 100vh;

      display: flex;

      justify-content: center;

      align-items: center;

      background:
        url(/images/upload-bg-image.png)
        no-repeat
        center center / cover;

      padding: 1rem;

    }


    /* =========================================================
       CARD
    ========================================================= */

    .card {

      background: #fff;

      padding: 2rem;

      border-radius: 16px;

      width: 100%;

      max-width: 600px;

      box-shadow:
        0 6px 18px rgba(0, 0, 0, 0.08);

    }


    .card h1 {

      text-align: center;

      margin-bottom: 1.5rem;

      color: #222;

    }


    /* =========================================================
       FORM SECTION
    ========================================================= */

    .form-section {

      display: flex;

      flex-direction: column;

      gap: 1rem;

      margin-top: 1rem;

      width: 100%;

    }


    /* =========================================================
       INPUTS
    ========================================================= */

    .input-field,
    textarea {

      width: 100%;

      padding: 0.9rem;

      border-radius: 8px;

      border:
        1.8px solid rgba(0, 0, 0, 0.35);

      font-size: 1rem;

      outline: none;

      transition:
        border 0.3s,
        box-shadow 0.3s;

      /* Important for Unicode / emoji / Hindi etc. */
      font-family:
        'Gill Sans',
        'Gill Sans MT',
        Calibri,
        'Trebuchet MS',
        sans-serif;

    }


    .input-field:focus,
    textarea:focus {

      border-color: #007bff;

      box-shadow:
        0 0 6px rgba(0, 123, 255, 0.25);

    }


    textarea {

      resize: vertical;

      min-height: 100px;

      max-height: 250px;

    }


    /* =========================================================
       FIELD WRAPPER
    ========================================================= */

    .field-wrapper {

      width: 100%;

    }


    /* =========================================================
       CHARACTER COUNTER
    ========================================================= */

    .character-count {

      display: block;

      text-align: right;

      margin-top: 4px;

      font-size: 0.78rem;

      color: #777;

      user-select: none;

    }


    .character-count.limit {

      color: #d9534f;

      font-weight: 600;

    }


    /* =========================================================
       UPLOAD BOX
    ========================================================= */

    .upload-box {

      margin-top: 1rem;

      padding: 2rem;

      border:
        2px dashed #bbb;

      border-radius: 12px;

      text-align: center;

      cursor: pointer;

      background-color:
        rgba(194, 194, 194, 0.15);

      transition:
        background 0.3s,
        border-color 0.3s;

      display: flex;

      flex-direction: column;

      align-items: center;

      gap: 0.8rem;

    }


    .upload-box:hover {

      border-color: #007bff;

      background-color:
        rgba(194, 194, 194, 0.25);

    }


    .upload-box.dragging {

      border-color: #007bff;

      background-color:
        rgba(0, 123, 255, 0.08);

    }


    .upload-box img {

      width: 40px;

      height: 40px;

      opacity: 0.7;

    }


    .upload-box span {

      font-size: 0.95rem;

      color: #555;

      word-break: break-word;

    }


    .upload-box input[type="file"] {

      display: none;

    }


    /* =========================================================
       UPLOAD LIMIT
    ========================================================= */

    .upload-limit {

      margin-top: 1rem;

      display: flex;

      align-items: center;

      gap: 0.5rem;

      font-size: 0.9rem;

      color: #666;

    }


    .upload-limit img {

      width: 18px;

      height: 18px;

      opacity: 0.8;

      flex-shrink: 0;

    }


    /* =========================================================
       SUBMIT BUTTON
    ========================================================= */

    button {

      margin-top: 1.5rem;

      width: 100%;

      padding: 0.9rem;

      border: none;

      border-radius: 12px;

      background: #007bff;

      color: #fff;

      font-size: 1rem;

      font-weight: 600;

      cursor: pointer;

      transition:
        background 0.3s,
        transform 0.1s;

    }


    button:hover {

      background: #0056b3;

    }


    button:active {

      transform: scale(0.98);

    }


    button:disabled {

      opacity: 0.7;

      cursor: not-allowed;

    }


    /* =========================================================
       ERROR MESSAGE
    ========================================================= */

    .error-message {

      margin-top: 0.6rem;

      font-size: 0.9rem;

      color: #d9534f;

      font-weight: 500;

      text-align: center;

      min-height: 20px;

    }


    /* =========================================================
       MOBILE
    ========================================================= */

    @media (max-width: 450px) {

      body {

        padding: 0.5rem;

      }


      .card {

        padding: 1.2rem;

      }


      .upload-box {

        padding: 1.5rem;

      }

    }

  </style>

</head>


<body>


  <div class="card">

    <h1>Add New Notice</h1>


    <form
      id="notice-form"
      class="upload-form"
      action="/home/notice/new"
      method="post"
      enctype="multipart/form-data"
    >


      <!-- =====================================================
           TITLE
      ====================================================== -->

      <div class="form-section">


        <div class="field-wrapper">

          <input
            class="input-field"
            type="text"
            id="title"
            name="title"
            placeholder="Enter Notice Title (max 100 characters)"
            required
            maxlength="100"
            autocomplete="off"
          />

          <span
            id="title-count"
            class="character-count"
          >
            0/100
          </span>

        </div>


        <!-- ===================================================
             MESSAGE
        ==================================================== -->

        <div class="field-wrapper">

          <textarea
            id="mess"
            name="mess"
            placeholder="Enter Notice Message (max 500 characters)"
            maxlength="500"
          ></textarea>

          <span
            id="message-count"
            class="character-count"
          >
            0/500
          </span>

        </div>


      </div>


      <!-- =====================================================
           FILE UPLOAD
      ====================================================== -->

      <label
        class="upload-box"
        id="upload-box"
      >

        <img
          src="/images/icons/icon-upload.svg"
          alt="upload-icon"
          id="placeholder-img"
        />


        <span id="upload-text">
          Drag and drop or click to upload
        </span>


        <input
          type="file"
          id="img"
          name="img"
          accept=".jpg,.jpeg,.png,.pdf"
        />

      </label>


      <!-- =====================================================
           FILE LIMIT
      ====================================================== -->

      <div class="upload-limit">

        <img
          src="/images/icons/icon-info.svg"
          alt="upload-limit-icon"
        />

        <span>
          Upload JPG, JPEG, PNG, or PDF (max size 5MB)
        </span>

      </div>


      <!-- =====================================================
           SUBMIT
      ====================================================== -->

      <button
        type="submit"
        id="submit-btn"
      >
        Submit
      </button>


      <!-- =====================================================
           ERROR
      ====================================================== -->

      <div
        class="error-message"
        id="error-message"
      ></div>


    </form>

  </div>


  <script>

    /* =========================================================
       ELEMENTS
    ========================================================= */

    const form =
      document.getElementById("notice-form");

    const titleInput =
      document.getElementById("title");

    const messageInput =
      document.getElementById("mess");

    const fileInput =
      document.getElementById("img");

    const uploadBox =
      document.getElementById("upload-box");

    const uploadText =
      document.getElementById("upload-text");

    const errorMessage =
      document.getElementById("error-message");

    const titleCount =
      document.getElementById("title-count");

    const messageCount =
      document.getElementById("message-count");

    const submitButton =
      document.getElementById("submit-btn");


    /* =========================================================
       LIMITS
    ========================================================= */

    const TITLE_MIN = 3;

    const TITLE_MAX = 100;

    const MESSAGE_MIN = 3;

    const MESSAGE_MAX = 500;

    const MAX_FILE_SIZE =
      5 * 1024 * 1024;


    /* =========================================================
       CHARACTER COUNT
    ========================================================= */

    function updateCharacterCount(
      input,
      counter,
      max
    ) {

      const length =
        input.value.length;

      counter.textContent =
        `${length}/${max}`;


      if (length >= max) {

        counter.classList.add("limit");

      } else {

        counter.classList.remove("limit");

      }

    }


    titleInput.addEventListener(
      "input",
      () => {

        updateCharacterCount(
          titleInput,
          titleCount,
          TITLE_MAX
        );

      }
    );


    messageInput.addEventListener(
      "input",
      () => {

        updateCharacterCount(
          messageInput,
          messageCount,
          MESSAGE_MAX
        );

      }
    );


    /* =========================================================
       DRAG & DROP
    ========================================================= */

    uploadBox.addEventListener(
      "dragover",
      event => {

        event.preventDefault();

        uploadBox.classList.add("dragging");

      }
    );


    uploadBox.addEventListener(
      "dragleave",
      event => {

        event.preventDefault();

        uploadBox.classList.remove("dragging");

      }
    );


    uploadBox.addEventListener(
      "drop",
      event => {

        event.preventDefault();

        uploadBox.classList.remove("dragging");


        const files =
          event.dataTransfer.files;


        if (!files || !files.length) {

          return;

        }


        fileInput.files = files;

        showFileName(
          fileInput.files[0]
        );

      }
    );


    /* =========================================================
       FILE CHANGE
    ========================================================= */

    fileInput.addEventListener(
      "change",
      () => {

        showFileName(
          fileInput.files[0]
        );

      }
    );


    /* =========================================================
       SHOW FILE NAME
    ========================================================= */

    function showFileName(file) {

      if (!file) {

        uploadText.textContent =
          "Drag and drop or click to upload";

        return;

      }


      uploadText.textContent =
        file.name;

    }


    /* =========================================================
       CLEAR ERROR
    ========================================================= */

    titleInput.addEventListener(
      "input",
      () => {

        errorMessage.textContent = "";

      }
    );


    messageInput.addEventListener(
      "input",
      () => {

        errorMessage.textContent = "";

      }
    );


    /* =========================================================
       FORM SUBMIT
    ========================================================= */

    form.addEventListener(
      "submit",
      event => {


        errorMessage.textContent = "";


        /* =====================================================
           TITLE VALIDATION

           ANY CHARACTER IS ALLOWED.

           Examples:

           Hello
           Exam 2026
           Exam @ School #1
           Important!!! ⚠️
           🎉 Brain Hunt Olympiad
           परीक्षा सूचना 📢
           বাংলা
           中文
           日本語
           العربية

           No regex is used.
        ====================================================== */

        const title =
          titleInput.value.trim();


        if (title.length < TITLE_MIN) {

          event.preventDefault();

          errorMessage.textContent =
            "Title must contain at least 3 characters.";

          titleInput.focus();

          return;

        }


        if (title.length > TITLE_MAX) {

          event.preventDefault();

          errorMessage.textContent =
            "Title must not exceed 100 characters.";

          titleInput.focus();

          return;

        }


        /* =====================================================
           MESSAGE VALIDATION

           MESSAGE IS OPTIONAL.

           If entered:
           Minimum = 3
           Maximum = 500

           ANY CHARACTER IS ALLOWED.
        ====================================================== */

        const message =
          messageInput.value.trim();


        if (
          message.length > 0 &&
          message.length < MESSAGE_MIN
        ) {

          event.preventDefault();

          errorMessage.textContent =
            "Message must contain at least 3 characters.";

          messageInput.focus();

          return;

        }


        if (message.length > MESSAGE_MAX) {

          event.preventDefault();

          errorMessage.textContent =
            "Message must not exceed 500 characters.";

          messageInput.focus();

          return;

        }


        /* =====================================================
           FILE VALIDATION
        ====================================================== */

        const file =
          fileInput.files[0];


        if (file) {


          const validExtensions = [
            "jpg",
            "jpeg",
            "png",
            "pdf"
          ];


          const extension =
            file.name
              .split(".")
              .pop()
              .toLowerCase();


          /* ---------------------------------------------------
             EXTENSION
          --------------------------------------------------- */

          if (
            !validExtensions.includes(
              extension
            )
          ) {

            event.preventDefault();

            errorMessage.textContent =
              "File type must be JPG, JPEG, PNG, or PDF.";

            return;

          }


          /* ---------------------------------------------------
             FILE SIZE
          --------------------------------------------------- */

          if (
            file.size > MAX_FILE_SIZE
          ) {

            event.preventDefault();

            errorMessage.textContent =
              "File size must not exceed 5MB.";

            return;

          }

        }


        /* =====================================================
           ALL VALID
        ====================================================== */

        submitButton.disabled = true;

        submitButton.textContent =
          "Submitting...";

      }
    );


    /* =========================================================
       INITIAL COUNTERS
    ========================================================= */

    updateCharacterCount(
      titleInput,
      titleCount,
      TITLE_MAX
    );


    updateCharacterCount(
      messageInput,
      messageCount,
      MESSAGE_MAX
    );

  </script>

</body>

</html>