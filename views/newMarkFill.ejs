<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Bulk Marks Entry</title>

<style>
*{box-sizing:border-box}

:root{
    --primary:#155eef;
    --primary-dark:#123ea8;
    --text:#101828;
    --muted:#667085;
    --border:#e4e7ec;
    --bg:#f5f7fb;
    --card:#fff;
    --soft:#eef4ff;
    --success:#067647;
    --danger:#b42318;
}

body{
    margin:0;
    min-height:100vh;
    background:var(--bg);
    color:var(--text);
    font-family:Arial,Helvetica,sans-serif;
}

.page{
    max-width:900px;
    margin:auto;
    padding:24px 14px 50px;
}

.card{
    background:#fff;
    border:1px solid var(--border);
    border-radius:18px;
    box-shadow:0 12px 35px rgba(16,24,40,.08);
    overflow:hidden;
}

.top{
    padding:24px;
    background:linear-gradient(135deg,#0f172a,#173b8f);
    color:#fff;
}

.kicker{
    font-size:10px;
    font-weight:800;
    letter-spacing:.12em;
    text-transform:uppercase;
    opacity:.8;
}

h1{
    margin:7px 0 5px;
    font-size:25px;
}

.subtitle{
    font-size:12px;
    opacity:.78;
}

.form{
    padding:22px;
}

.grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
}

.field label{
    display:block;
    margin-bottom:7px;
    font-size:11px;
    font-weight:800;
    color:#344054;
}

select{
    width:100%;
    height:45px;
    padding:0 12px;
    border:1px solid #cfd4dc;
    border-radius:10px;
    background:#fff;
    color:#101828;
    font-size:13px;
    font-weight:600;
}

select:focus{
    outline:none;
    border-color:var(--primary);
    box-shadow:0 0 0 3px rgba(21,94,239,.12);
}

.info{
    margin-top:18px;
    padding:12px 14px;
    border:1px solid #dbe7ff;
    background:var(--soft);
    border-radius:10px;
    color:#174ea6;
    font-size:11px;
    line-height:1.55;
}

.actions{
    margin-top:20px;
    display:flex;
    justify-content:flex-end;
}

button{
    height:44px;
    padding:0 22px;
    border:0;
    border-radius:10px;
    background:var(--primary);
    color:#fff;
    font-weight:800;
    cursor:pointer;
}

button:disabled{
    opacity:.45;
    cursor:not-allowed;
}

.message{
    margin-bottom:18px;
    padding:11px 13px;
    border-radius:9px;
    font-size:11px;
}

.success{
    background:#ecfdf3;
    border:1px solid #abefc6;
    color:var(--success);
}

.error{
    background:#fff1f3;
    border:1px solid #fecdca;
    color:var(--danger);
}

@media(max-width:650px){
    .page{padding:8px}
    .top{padding:18px}
    .form{padding:15px}
    h1{font-size:21px}
    .grid{grid-template-columns:1fr}
}
</style>
</head>

<body>

<div class="page">
<div class="card">

<div class="top">
    <div class="kicker">St. Columbus Public School</div>
    <h1>Bulk Marks Entry</h1>
    <div class="subtitle">
        Select class, term and subject to enter marks for the complete class.
    </div>
</div>

<div class="form">

<% if(success){ %>
<div class="message success">
    Marks saved successfully.
    <strong><%= success %></strong> mark(s) updated.
</div>
<% } %>

<% if(error){ %>
<div class="message error">
    <%= error %>
</div>
<% } %>

<form method="POST" action="/marksheet/new/mark-fill/load" id="setupForm">

<div class="grid">

<div class="field">
    <label for="className">CLASS</label>

    <select name="className" id="className" required>
        <option value="">Select Class</option>

        <option value="Nursery">Nursery</option>
        <option value="LKG">LKG</option>
        <option value="UKG">UKG</option>

        <% for(let i=1;i<=8;i++){ %>
            <option value="<%= i %>">
                Class <%= i %>
            </option>
        <% } %>
    </select>
</div>


<div class="field">
    <label for="term">TERM</label>

    <select name="term" id="term" required>
        <option value="">Select Term</option>
        <option value="I" selected >Term I — PT-1, PT-2, Halfyearly</option>
        <option value="II">Term II — PT-3, PT-4, Annual</option>
    </select>
</div>


<div class="field">
    <label for="subject">SUBJECT</label>

    <select
        name="subject"
        id="subject"
        required
        disabled
    >
        <option value="">
            Select class and term first
        </option>
    </select>
</div>

</div>


<div class="info">
    <strong>Mark entry rules:</strong><br>
    Term I: PT-1 (10), PT-2 (10), Halfyearly (80).<br>
    Term II: PT-3 (10), PT-4 (10), Annual (80).<br>
    Blank = no change. 0 = valid mark. Existing marks remain visible.
</div>


<div class="actions">
    <button
        type="submit"
        id="nextButton"
        disabled
    >
        Next: Student List
    </button>
</div>

</form>

</div>
</div>
</div>


<script>
const subjectsByClass =
    <%- JSON.stringify(subjectsByClass || {}) %>;

const classSelect =
    document.getElementById("className");

const termSelect =
    document.getElementById("term");

const subjectSelect =
    document.getElementById("subject");

const nextButton =
    document.getElementById("nextButton");


function updateSubjects(){

    const className =
        classSelect.value;

    const term =
        termSelect.value;


    subjectSelect.innerHTML =
        "";


    if(
        !className ||
        !term
    ){

        subjectSelect.disabled = true;

        const option =
            document.createElement("option");

        option.value = "";

        option.textContent =
            "Select class and term first";

        subjectSelect.appendChild(option);

        nextButton.disabled = true;

        return;
    }


    const subjects =
        subjectsByClass?.[className]?.[term]
        || [];


    if(!subjects.length){

        subjectSelect.disabled = true;

        const option =
            document.createElement("option");

        option.value = "";

        option.textContent =
            "No common subjects found";

        subjectSelect.appendChild(option);

        nextButton.disabled = true;

        return;
    }


    subjectSelect.disabled = false;


    const first =
        document.createElement("option");

    first.value = "";

    first.textContent =
        "Select Subject";

    subjectSelect.appendChild(first);


    subjects.forEach(subject => {

        const option =
            document.createElement("option");

        option.value =
            subject.value;

        option.textContent =
            subject.label;

        subjectSelect.appendChild(option);
    });


    validate();
}


function validate(){

    nextButton.disabled =
        !classSelect.value ||
        !termSelect.value ||
        !subjectSelect.value;
}


classSelect.addEventListener(
    "change",
    updateSubjects
);

termSelect.addEventListener(
    "change",
    updateSubjects
);

subjectSelect.addEventListener(
    "change",
    validate
);
</script>

</body>
</html>
