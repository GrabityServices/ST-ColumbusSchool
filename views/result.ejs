<%
    const student = data?.student || {};
    const exams = data?.exams || {};

    const PT1 = exams.PT1 || null;
    const PT2 = exams.PT2 || null;
    const Halfyearly = exams.Halfyearly || null;
    const PT3 = exams.PT3 || null;
    const PT4 = exams.PT4 || null;
    const Annual = exams.Annual || null;

    const subjects = [
        { key: "english",  name: "ENGLISH" },
        { key: "hindi",    name: "HINDI" },
        { key: "math",     name: "MATHEMATICS" },
        { key: "gsc",      name: "SCIENCE" },
        { key: "gk",       name: "GENERAL KNOWLEDGE" },
        { key: "sst",      name: "SOCIAL SCIENCE" },
        { key: "computer", name: "COMPUTER" },
        { key: "language", name: "SANSKRIT / URDU" },
    ];

    const isUKG =
    String(student.class || "").trim().toUpperCase() === "UKG";

const ukgHiddenSubjects = subjects

const displaySubjects = subjects

    function getMark(exam, key) {
        if (!exam) return "";
        const value = exam[key];
        if (value === undefined || value === null || value === "") return "";
        return value;
    }

    function numberOrZero(value) {
        if (value === undefined || value === null || value === "" || value === "AB") {
            return 0;
        }
        const n = Number(value);
        return Number.isFinite(n) ? n : 0;
    }

    function subjectTotal(examList, key) {
        let total = 0;
        let found = false;
        let absent = false;

        for (const exam of examList) {
            if (!exam) continue;

            const value = exam[key];

            if (value === "AB") {
                absent = true;
                found = true;
                continue;
            }

            if (value !== undefined && value !== null && value !== "") {
                total += numberOrZero(value);
                found = true;
            }
        }

        if (!found) return "";
        if (absent) return "AB";
        return total;
    }

    function percentage(total, maximum = 100) {
        if (total === "AB" || total === "" || total === null || total === undefined) {
            return "";
        }
        return ((Number(total) / maximum) * 100).toFixed(0);
    }

    function grade(value) {
        if (value === "" || value === null || value === undefined || value === "AB") {
            return "";
        }

        const p = Number(value);

        if (!Number.isFinite(p)) return "";
        if (p >= 91) return "A1";
        if (p >= 81) return "A2";
        if (p >= 71) return "B1";
        if (p >= 61) return "B2";
        if (p >= 51) return "C1";
        if (p >= 41) return "C2";
        if (p >= 33) return "D";
        return "E";
    }

    function displayMark(value) {
        if (value === "AB") {
            return '<span class="absent">__</span>';
        }

        if (value === "" || value === null || value === undefined) {
            return "__";
        }

        return value;
    }

  function examTotal(
    exam,
    subjectList = displaySubjects
) {
    if (!exam) return 0;

    return subjectList.reduce(
        (sum, subject) =>
            sum + numberOrZero(exam[subject.key]),
        0
    );
}

   function termTotal(examList) {
    return examList.reduce(
        (sum, exam) =>
            sum + examTotal(exam, displaySubjects),
        0
    );
}

    const termI = [PT1, PT2, Halfyearly];
    const termII = [PT3, PT4, Annual];

    const subjectMaximum = 100;

const maximumMarks = isUKG ? 600 : 800;

    const termITotal = termTotal(termI);
    const termIITotal = termTotal(termII);

    const termIPercentage = maximumMarks
        ? ((termITotal / maximumMarks) * 100).toFixed(2)
        : "";

    const termIIPercentage = maximumMarks
        ? ((termIITotal / maximumMarks) * 100).toFixed(2)
        : "";

    const totalYearMarks = termITotal + termIITotal;
    const yearlyMaximum = maximumMarks * 2;

    const yearlyPercentage = yearlyMaximum
        ? ((totalYearMarks / yearlyMaximum) * 100).toFixed(2)
        : "";

const attendance = data?.attendance || {};

const attendanceWorking =
    attendance?.termI?.workingDays ?? "";

const attendancePresent =
    attendance?.termI?.present ?? "";

const attendanceAbsent =
    attendance?.termI?.absent ?? "";

const scholastic =
    data?.schoolist?.termI || {};

    const scholasticAreas = [
        { key: "listening", name: "LISTENING SKILL" },
        { key: "speaking", name: "SPEAKING SKILL" },
        { key: "reading", name: "READING SKILL" },
        { key: "writing", name: "WRITING SKILL" },
        { key: "collaboration", name: "COLLABORATION & COOPERATION" },
        { key: "peers", name: "RELATIONS WITH PEERS" },
        { key: "teachers", name: "RELATIONS WITH TEACHERS" },
        { key: "discipline", name: "DISCIPLINE, PUNCTUALITY & REGULARITY" },
        { key: "cleanliness", name: "CLEANLINESS (HAIR, HANDS, NAILS, SHOES & UNIFORM)" },
        { key: "artCraft", name: "ART AND CRAFT" },
        { key: "drawing", name: "DRAWING" },
        { key: "musicDanceDrama", name: "MUSIC, DANCE, DRAMA" }
    ];
function scholasticValue(key) {
    return scholastic[key] ?? "";
}
