<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Progress Report - <%= data?.student?.name || 'Student' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Ultra&display=swap" rel="stylesheet">

<style>
*,
*::before,
*::after {
    box-sizing: border-box;
}

:root {
    --maroon: #74151d;
    --maroon-dark: #5b0f16;
    --maroon-soft: #8f3035;
    --gold: #d59b32;
    --gold-light: #f4dfae;
    --cream: #fffaf0;
    --cream-2: #fffdf8;
    --paper: #ffffff;
    --ink: #292929;
    --muted: #6e625a;
    --line: #d8c9b4;
    --line-dark: #9f8060;
    --green: #fff3b0;
    --green-ink: #6b4d00;
    --total: #f2eee8;
    --absent: #a61f2f;
}

html,
body {
    margin: 0;
    padding: 0;
    min-height: 100%;
}

body {
    background:
        radial-gradient(circle at top left, #fff8e8 0, #f1e8dc 38%, #e5ddd4 100%);
    color: var(--ink);
    font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    overflow-x: hidden;
}

/* =========================
   PAGE
   ========================= */

.report-page {
    width: min(1400px, calc(100% - 28px));
    margin: 14px auto;
    padding: 12px;
    background: var(--paper);
    border: 1px solid var(--maroon);
    box-shadow: 0 12px 30px rgba(91, 15, 22, .12);
}

/* =========================
   HEADER
   ========================= */

.school-heading {
    position: relative;
    padding: 13px 155px 12px;
    margin-bottom: 7px;
    text-align: center;
    border: 1px solid var(--maroon);
    background:
        linear-gradient(90deg, #fffaf0 0%, #ffffff 48%, #fffaf0 100%);
    overflow: hidden;
}

.school-heading::before,
.school-heading::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 7px;
    background: var(--maroon);
}

.school-heading::before {
    left: 0;
}

.school-heading::after {
    right: 0;
}

 .school-name-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    width: 100%;
}

.school-logo {
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    object-fit: contain;
    display: block;
}

.school-heading h1 {
    margin: 0;
    color: var(--maroon);
    font-size: clamp(21px, 2vw, 29px);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 2px;
    .ultra-regular {
  font-style: normal;
  font-family: "Ultra", Georgia, serif;
font-weight: 400;
}

}

.school-heading h2 {
    margin: 5px 0 0;
    color: #604c3c;
    font-size: 15px;
    line-height: 1.1;
    font-weight: 600;
    margin-top: -10px;
    letter-spacing: .65px;
    text-transform: uppercase;
}

.report-title {
    margin-top: 7px;
    color: var(--maroon);
    font-size: 14px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

.session-badge {
    display: inline-block;
    margin-top: 7px;
    padding: 4px 13px;
    border: 1px solid var(--gold);
    border-radius: 20px;
    background: var(--gold-light);
    color: var(--maroon-dark);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .8px;
}

/* =========================
   STUDENT INFO
   ========================= */

.student-info {
    display: grid;
    grid-template-columns: 1.15fr 2.25fr .9fr 1.05fr;
    margin-bottom: 8px;
    border: 1px solid var(--line-dark);
    background: var(--cream-2);
}

.student-info .item {
    min-width: 0;
    padding: 10px 12px;
    border-right: 1px solid var(--line);
    font-size: 17px;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.student-info .item:last-child {
    border-right: 0;
}

.student-info strong {
    color: var(--maroon);
    margin-right: 6px;
    font-weight: 700;
}

/* =========================
   MAIN GRID
   ========================= */

.main-grid {
    display: grid;
    grid-template-columns: minmax(0, 3.18fr) minmax(300px, 1fr);
    gap: 7px;
    align-items: start;
}

.term-box,
.side-box {
    border: 1px solid var(--line-dark);
    background: #fff;
}

.term-box {
    margin-bottom: 7px;
}

.term-title,
.side-title {
    background: linear-gradient(90deg, var(--maroon), var(--maroon-soft), var(--maroon));
    color: #fff;
    text-align: center;
    text-transform: uppercase;
    font-weight: 650;
}

.term-title {
    padding: 6px 7px;
    font-size: 10px;
    letter-spacing: .5px;
}

.side-title {
    padding: 6px 7px;
    font-size: 10px;
    letter-spacing: .4px;
}

.term-subtitle {
    padding: 4px;
    border-bottom: 1px solid var(--line);
    background: var(--cream);
    color: var(--muted);
    text-align: center;
    font-size: 10px;
    line-height: 1.15;
}

/* =========================
   TABLES
   ========================= */

table {
    width: 100%;
    border-collapse: collapse;
}

.marks-table {
    table-layout: fixed;
    font-size: 13px;
}

.marks-table th,
.marks-table td {
    border: 1px solid var(--line);
    padding: 2px 3px;
    height: 25px;
    line-height: 1.15;
    text-align: center;
    vertical-align: middle;
}

.marks-table th {
    background: #f6f1e9;
    color: var(--maroon-dark);
    font-size: 12px;
    font-weight: 650;
}

.marks-table th small {
    font-size: 7px;
    font-weight: 500;
}

.marks-table tbody tr:nth-child(even):not(:last-child) {
    background: #fffdf9;
}

.marks-table td {
    color: #302d2a;
    font-size: 14px;
    font-weight: 400;
}

.marks-table td.subject {
    width: 25%;
    padding-left: 7px;
    text-align: left;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: normal;
    font-size: 14px;
    font-weight: 450;
    color: #3b2925;
}

.marks-table .fm {
    width: 7%;
}

.marks-table .exam-mark {
    width: 10%;
}

.marks-table .total {
    width: 12%;
}

.marks-table .percentage {
    width: 11%;
}

.marks-table .grade {
    width: 9%;
}

.marks-table .sum {
    background: var(--green);
    color: var(--green-ink);
    font-size: 14px;
    font-weight: 500;
}

.marks-table .grand {
    background: var(--total);
    color: var(--maroon-dark);
    font-size: 14px;
    font-weight: 500;
}

.marks-table .absent {
    color: var(--absent);
    font-weight: 600;
}

/* =========================
   RIGHT COLUMN
   ========================= */

.side-column {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.side-box {
    overflow: hidden;
}

.grading-table,
.scholastic-table {
    font-size: 9px;
}

.grading-table th,
.grading-table td,
.scholastic-table th,
.scholastic-table td {
    border: 1px solid var(--line);
    padding: 2px 4px;
    height: 20px;
    line-height: 1.15;
    text-align: center;
    font-size: 12px;
    vertical-align: middle;
}

.grading-table th,
.scholastic-table th {
    background: #f6f1e9;
    color: var(--maroon-dark);
    font-weight: 650;
}

.grading-table td,
.scholastic-table td {
    font-weight: 500;
    color: #3d3632;
}

.scholastic-table .area {
    width: 61%;
    text-align: left;
    white-space: normal;
    overflow-wrap: anywhere;
    font-weight: 550;
}

.scholastic-table .blank {
    height: 22px;
    min-height: 22px;
}

/* =========================
   ATTENDANCE
   ========================= */

.attendance {
    padding: 6px;
}

.attendance-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 5px;
}

.attendance-box {
    min-height: 42px;
    padding: 4px 3px;
    border: 1px solid var(--line);
    background: var(--cream-2);
    text-align: center;
    font-size: 11px;
    line-height: 1.15;
}

.attendance-box strong {
    color: var(--maroon);
    font-weight: 600;
    text-decoration:underline;
    padding: 0 0 2px 0;
}

.attendance-value {
    margin-top: 5px;
    min-height: 13px;
    color: var(--maroon-dark);
    font-size: 11px;
    font-weight: 650;
}

/* =========================
   REMARKS
   ========================= */

.remarks {
    padding: 6px;
}

.remarks-box {
    min-height: 42px;
    padding: 4px;
    border: 1px solid var(--line);
    background: #fffdf9;
    font-size: 11px;
    line-height: 1.35;
}

.signatures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 12px 6px 4px;
    text-align: center;
    font-size: 11px;
    color: #1c1b1a;
    align-items: end;
}

.signature-line {
    border-bottom: 1px solid var(--line-dark);
    min-height: 24px;
    padding: 0 4px 4px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-top: auto;
}

.principal-signature {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    height: 76px;
}

.principal-signature img {
    width: 130px;
    height: 48px;
    object-fit: contain;
    display: block;
    margin: auto auto 0;
    transform:rotate(-10deg)
}

.principal-signature .signature-line {
    width: 82%;
    margin-top: 0;
}

.stamp-box {
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: .7px;
    text-transform: uppercase;
    overflow: hidden;
}

.stamp-box img {
    width: 58px;
    height: 58px;
    object-fit: contain;
    display: block;
}

.principal-signature {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
}

.principal-signature img {
    width: 130px;
    height: 48px;
    object-fit: contain;
    display: block;
    transform:rotate(-10deg);

    margin: -2px auto 0;
}

.principal-signature .signature-line {
    width: 82%;
}

/* =========================
   LEGEND
   ========================= */

/* =========================
   SCREEN CONTROLS
   ========================= */

.actions {
    position: fixed;
    left: 50%;
    bottom: 15px;

    transform: translateX(-50%);

    z-index: 100;

    display: flex;
    justify-content: center;
}
.print-btn {
    border: 1px solid var(--maroon-dark);
    border-radius: 6px;
    background: var(--maroon);
    color: #fff;
    padding: 10px 15px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 5px 15px rgba(91, 15, 22, .2);
}

.print-btn:hover {
    background: var(--maroon-dark);
}

body > a {
    position: fixed;
    bottom: 6px;
    z-index: 90;
    padding: 4px 7px;
    border: 1px solid var(--line);
    background: rgba(255,255,255,.96);
    color: var(--maroon-dark);
    font-size: 9px;
    text-decoration: none;
}

body > a:first-of-type {
    left: 7px;
}

body > a:last-of-type {
    right: 7px;
}

.grading-bottom {
    margin-top: 7px;
}

.grading-bottom .grading-table td {
    text-align: center;
    font-weight: 600;
    color: var(--maroon-dark);
}

@media print {
    .grading-bottom {
        margin-top: 3px;
    }

    .grading-bottom .grading-table td {
        height: 18px;
        padding: 1px 3px;
        font-size: 10px;
    }
}

/* =========================
   PRINT — A4 LANDSCAPE
   Same visual system, compact geometry
   ========================= */

@page {
    size: A4 landscape;
    margin: 0;
}

@media print {
    html,
    body {
        width: 297mm;
        height: 210mm;
        margin: 0 !important;
        padding: 0 !important;
        background: #fff !important;
        overflow: hidden !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    .report-page {
        width: 297mm;
        height: 210mm;
        min-height: 210mm;
        margin: 0 !important;
        padding: 3.2mm;
        border: 1px solid var(--maroon);
        background-color: #f9cdb4;
        box-shadow: none;
        overflow: hidden;
    }

    /*
     * A4 LANDSCAPE PRINT GEOMETRY
     * The previous print rules compressed the entire report vertically,
     * leaving a large unused area at the bottom. These dimensions
     * deliberately use the available 210mm page height.
     */
    .school-heading {
        padding: 5px 40px 5px;
    }

    .school-name-row {
        gap: 10px;
        padding: 5px 0;

    }

    .school-logo {
        width: 60px;
        height: 60px;
        flex-basis: 38px;
        transform: translateY(2px);
        position: absolute;
    }

    .l1{
        position: absolute;
        left: 300px;
        top: 2px;
    }
    .qr{
         position: absolute;
        right: 300px;
        top: 2px;
    }
    .school-heading h1 {
        font-size: 20px;
    }

    .school-heading h2 {
        font-size: 15px;
        margin: 0;
        padding: 0;
    }

    .report-title {
        margin-top: 4px;
        font-size: 11px;
    }

    /* .session-badge {
        margin-top: 3px;
        padding: 3px 9px;
        font-size: 8px;
        display: none;
    } */

    .student-info {
        margin-bottom: 3px;
    }

    .student-info {
        grid-template-columns: 1.15fr 2.25fr .9fr 1.05fr;
    }

    .student-info .item {
        padding: 2px 7px;
        font-size: 15px;
    }

    .main-grid {
        grid-template-columns: minmax(0, 3.18fr) minmax(215px, 1fr);
        gap: 3px;
        align-items: stretch;
    }

    .main-grid > div:first-child,
    .main-grid > .side-column {
        min-height: 0;
    }

    .term-box {
        margin-bottom: 3px;
    }

    .term-title {
        padding: 5px 3px;
        font-size: 11px;
        line-height: 1.15;
        font-weight: 700;
        color: #fff8e8;
    }

    .term-subtitle {
        padding: 3px 2px;
        font-size: 9px;
        font-weight: 600;
        color: var(--maroon-dark);
        line-height: 1.2;
    }

    .marks-table {
        font-size: 11px;
    }

    .marks-table th,
    .marks-table td {
        height: 23px;
        padding: 2px 2px;
        font-size: 1px;
        line-height: 1.15;
        font-weight: 400;
    }

    .marks-table th {
        height: 25px;
        font-size: 12px;
        font-weight: 550;
    }

    .marks-table th small {
        font-size: 9px;
        font-weight: 500;
    }

    .marks-table td.subject {
        font-size: 11px;
        padding-left: 4px;
        font-weight: 400;
    }

    .side-column {
        gap: 3px;
    }

    .side-title {
        padding: 5px 3px;
        line-height: 1.15;
    }

    .grading-table,
    .scholastic-table {
        font-size: 10px;
    }

    .grading-table th,
    .grading-table td {
        height: 18px;
        padding: 1px 3px;
        font-size: 10px;
    }

    .grading-table {
        table-layout: fixed;
    }

    .grading-table th,
    .grading-table td {
        width: 25%;
    }

    .scholastic-table th,
    .scholastic-table td {
        height: 20px;
        padding: 1px 2px;
        font-size: 6.3px;
        line-height: 1.15;
    }

    .scholastic-table .blank {
        height: 23px;
        min-height: 23px;
    }

    .attendance {
        padding: 3px;
    }

    .attendance-grid {
        gap: 2px;
    }

    .attendance-box {
        min-height: 38px;
        padding: 3px 2px;
        font-size: 11px;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        text-decoration: none;
    }
    .attendance-box strong{
        text-decoration: none;
        border-bottom: 1px solid;
    }

    .attendance-value {
        margin-top: 3px;
        font-size: 9px;
        min-height: 8px;
        text-decoration: none;
        /* pad */
    }

    .remarks {
        padding: 3px;
    }

    .remarks-box {
        min-height: 25px;
        padding: 2px;
        font-size: 6px;
    }

    .signatures {
        gap: 4px;
        padding: 6px 3px 2px;
        font-size: 5.8px;
        align-items: end;
    }

    .signature-line {
        min-height: 18px;
        padding: 0 2px 2px;
    }

    .principal-signature {
        height: 48px;
    }

    .stamp-box {
        height: 30px;
        font-size: 6px;
    }

    .stamp-box img {
        width: 38px;
        height: 38px;
    }

    .principal-signature img {
        width: 95px;
        height: 30px;
        margin: -1px auto 0;
    transform:rotate(-10deg)

    }

    .principal-signature .signature-line {
        width: 82%;
    }

    .actions,
    body > a {
        display: none !important;
    }
}

/* =========================
   SCREEN RESPONSIVENESS
   ========================= */

@media screen and (max-width: 1050px) {
    .report-page {
        width: calc(100% - 14px);
        margin: 7px;
        padding: 7px;
    }

    .main-grid {
        grid-template-columns: 1fr;
    }

    .side-column {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: start;
    }
}

@media screen and (max-width: 700px) {
    .school-heading {
        padding: 10px 12px;
    }

    .school-name-row {
        gap: 8px;
    }

    .school-logo {
        width: 38px;
        height: 38px;
        flex-basis: 38px;
        transform: translateY(2px);
    }

    .school-heading h1 {
        font-size: 18px;
    }

    .student-info {
        grid-template-columns: 1fr 1fr;
    }

    .student-info .item {
        font-size: 10px;
        border-bottom: 1px solid var(--line);
    }

    .main-grid {
        grid-template-columns: 1fr;
    }

    .side-column {
        display: flex;
    }

    .marks-table {
        font-size: 8px;
    }

    .marks-table th,
    .marks-table td {
        padding: 3px 2px;
        height: 27px;
    }

    .marks-table th {
        font-size: 7px;
    }

    .marks-table td.subject {
        font-size: 8px;
    }

    .grading-table,
    .scholastic-table {
        font-size: 8px;
    }

    .grading-table th,
    .grading-table td,
    .scholastic-table th,
    .scholastic-table td {
        font-size: 8px;
    }

    .actions {
        right: 8px;
        bottom: 8px;
    }

    .print-btn {
        padding: 8px 11px;
        font-size: 10px;
    }
}

/* =========================================================
   FINAL UI/UX POLISH
   Larger marks + warm yellow highlights + tight A4 geometry
   ========================================================= */

/* Screen: make actual marks visually dominant */
.marks-table td:not(.subject):not(.sum):not(.grand),
.marks-table td.sum,
.marks-table td.grand,
.marks-table td.grade-merged {
    font-size: 15px;
    font-weight: 650;
    letter-spacing: .1px;
}

.marks-table td.subject {
    font-size: 14px;
    font-weight: 550;
}

.marks-table .sum {
    background: #fef5c1;
    color: #6b4d00;
}

.grade-merged {
    background: #fef5c1;
    color: #6b4d00;
    font-size: 18px !important;
    font-weight: 800 !important;
    vertical-align: middle;
}

/* Grading scale: clear 4 × 4 visual rhythm */
.grading-bottom {
    margin-top: 3px;
}

.grading-bottom .term-title {
    padding: 4px 3px;
    font-size: 9px;
}

.grading-bottom .grading-table {
    table-layout: fixed;
}

.grading-bottom .grading-table td {
    width: 25%;
    height: 22px;
    padding: 1px 4px;
    background: #fff3b0;
    color: #5f4700;
    font-size: 13px;
    line-height: 1;
    font-weight: 750;
    border-color: #d6b85b;
}

.grading-bottom .grading-table td:nth-child(2n) {
    font-weight: 850;
    color: #6a4a00;
}

/* Keep the whole printable composition inside A4 with no accidental overflow. */
@media print {
    .report-page {
        width: 297mm;
        height: 210mm;
        min-height: 210mm;
        max-height: 210mm;
        padding: 2.8mm;
        overflow: hidden;
    }

    .main-grid {
        gap: 2.5px;
    }

    .term-box {
        margin-bottom: 2px;
    }

    /* Bigger marks, but fixed row geometry prevents vertical expansion. */
    .marks-table {
        font-size: 13px;
    }

    .marks-table th,
    .marks-table td {
        height: 22px;
        min-height: 22px;
        padding: 1px 2px;
        font-size: 13.5px;
        line-height: 1;
        font-weight: 650;
    }

    .marks-table th {
        height: 24px;
        font-size: 10px;
        font-weight: 650;
    }

    .marks-table th small {
        font-size: 7px;
    }

    .marks-table td.subject {
        font-size: 12.5px;
        font-weight: 550;
        padding-left: 4px;
        line-height: 1;
    }

    .marks-table td.sum,
