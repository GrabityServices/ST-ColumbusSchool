                <%= total %>
            </td>

            <td class="sum">
                <%= pct %><%= pct !== "" ? "%" : "" %>
            </td>

            <% if (index === 0) { %>
                <!-- ONE GRADE CELL FOR THE COMPLETE TERM -->
                <td
    class="grade-merged"
    rowspan="<%= displaySubjects.length %>"
>
    <%= grade(termIPercentage) %>
</td>
            <% } %>
        </tr>
    <% }) %>

    <!-- TOTAL -->
    <tr>
        <td class="subject grand">
            TOTAL
        </td>

        <td class="grand">
            <%= maximumMarks %>
        </td>

        <td class="grand">__</td>
        <td class="grand">__</td>
        <td class="grand">__</td>

        <td class="grand">
            <%= termITotal %>
        </td>

        <td class="grand">
            <%= termIPercentage %>%
        </td>
    </tr>
</tbody>

                </table>
            </section>

            <!-- TERM II -->
            <section class="term-box">

                <div class="term-title">
                    PEN PAPER TESTS — TERM II
                </div>

                <div class="term-subtitle">
                    PT3 (10) + PT4 (10) + ANNUAL EXAM (80)
                </div>

                <table class="marks-table">

                    <thead>
                        <tr>
                            <th class="subject">MAIN SUBJECTS</th>
                            <th class="fm">F.M.</th>
                            <th class="exam-mark">PT3<br><small>(10)</small></th>
                            <th class="exam-mark">PT4<br><small>(10)</small></th>
                            <th class="exam-mark">ANNUAL<br><small>(80)</small></th>
                            <th class="total">TOTAL</th>
                            <th class="percentage">PERCENTAGE</th>
                            <th class="grade">GRADE</th>
                        </tr>
                    </thead>

                    <tbody>
   <% displaySubjects.forEach((subject, index) => {
        const total = subjectTotal(termII, subject.key);
        const pct = percentage(total, subjectMaximum);
    %>
       <tr style="opacity: <%= isUKG && (subject.key === 'language' || subject.key === 'computer') ? 0 : 1 %>;">
            <td class="subject">
                <%= subject.name %>
            </td>

            <td>100</td>

            <td>
                <%- displayMark(getMark(PT3, subject.key)) %>
            </td>

            <td>
                <%- displayMark(getMark(PT4, subject.key)) %>
            </td>

            <td>
                <%- displayMark(getMark(Annual, subject.key)) %>
            </td>

            <td class="sum">
                <%= total %>
            </td>

            <td class="sum">
                <%= pct %><%= pct !== "" ? "%" : "" %>
            </td>

            <% if (index === 0) { %>
                <!-- ONE GRADE CELL FOR THE COMPLETE TERM -->
                <td
    class="grade-merged"
    rowspan="<%= displaySubjects.length %>"
>
    <%= grade(termIIPercentage) %>
</td>
            <% } %>
        </tr>
    <% }) %>

    <!-- TOTAL -->
    <tr>
        <td class="subject grand">
            TOTAL
        </td>

        <td class="grand">
            <%= maximumMarks %>
        </td>

        <td class="grand">__</td>
        <td class="grand">__</td>
        <td class="grand">__</td>

        <td class="grand">
            <%= termIITotal %>
        </td>

        <td class="grand">
            <%= termIIPercentage %>%
        </td>
    </tr>
</tbody>

                </table>
            </section>

            <!-- GRADING SCALE — AFTER TERM II -->
            <section class="term-box grading-bottom">
                <div class="term-title">
                    GRADING SCALE FOR SCHOLASTIC AREA
                </div>

                <table class="grading-table">
                    <tbody>
                        <tr>
                            <td>91 – 100</td><td>A1</td>
                            <td>81 – 90</td><td>A2</td>
                        </tr>
                        <tr>
                            <td>71 – 80</td><td>B1</td>
                            <td>61 – 70</td><td>B2</td>
                        </tr>
                        <tr>
                            <td>51 – 60</td><td>C1</td>
                            <td>41 – 50</td><td>C2</td>
                        </tr>
                        <tr>
                            <td>33 – 40</td><td>D</td>
                            <td>0 – 32</td><td>E</td>
                        </tr>
                    </tbody>
                </table>
            </section>
</div>

        <!-- RIGHT SIDE -->
        <div class="side-column">

            <!-- SCHOLASTIC -->
            <section class="side-box">

                <div class="side-title">
                    SCHOLASTIC AREA
                </div>

                <table class="scholastic-table">

                    <thead>
                        <tr>
                            <th class="area">AREA</th>
                            <th>TERM I</th>
                            <th>TERM II</th>
                        </tr>
                    </thead>

                  <tbody>

    <% scholasticAreas.forEach(area => { %>

        <tr>

            <td class="area">
                <%= area.name %>
            </td>

            <td class="blank">
                <%= data?.schoolist?.termI?.[area.key] ?? "" %>
            </td>

            <td class="blank">
                <%= data?.schoolist?.termII?.[area.key] ?? "" %>
            </td>

        </tr>

    <% }) %>

</tbody>

                </table>

            </section>

            <!-- ATTENDANCE -->
            <section class="side-box">

                <div class="side-title">
                    ATTENDANCE
                </div>

                <div class="attendance">
                    <div class="attendance-grid">

                        <div class="attendance-box">
                            <strong>WORKING DAYS</strong>
                          <div class="attendance-value">
</div>
                        </div>

                        <div class="attendance-box">
                            <strong>PRESENT</strong>
                            <div class="attendance-value">
</div>
                        </div>

                        <div class="attendance-box">
                            <strong>ABSENT</strong>
                           <div class="attendance-value">
</div>
                        </div>

                    </div>
                </div>

            </section>

            <!-- REMARKS -->
            <section class="side-box">

                <div class="side-title">
                    TEACHER'S SUGGESTIVE REMARKS
                </div>

                <div class="remarks">
                    <div class="remarks-box">
                        <%= data?.remarks || "" %>
                    </div>
                </div>

                <div class="signatures">
                    <div class="signature-line class-teacher-signature">CLASS TEACHER</div>

                    <div class="stamp-box">
                    </div>
                    <div class="principal-signature">
                        <img width="100" height="50"   src="/psign.png" alt="Principal Signature">
                        <div class="signature-line">PRINCIPAL</div>
                    </div>
                </div>

            </section>

        </div>
    </div>

    <!-- NOTATIONS — bottom of the report -->
<section class="notations">
    <div class="notations-title">Notations | Links!</div>

    <div class="notations-text">
        <b>F.M.</b> = Full Marks
        &nbsp;&nbsp;|&nbsp;&nbsp;

        <b>PT</b> = Pen Paper Test
        &nbsp;&nbsp;|&nbsp;&nbsp;

        <b>—</b> = Not Applicable
        &nbsp;&nbsp;|&nbsp;&nbsp;

        <b>%</b> = Percentage
        &nbsp;&nbsp;|&nbsp;&nbsp;

        <b>Grade:</b> A1 (Highest) to E (Lowest)
        &nbsp;&nbsp;|&nbsp;&nbsp;

        <b>Visit Our Website:</b>
        stcolumbusekdara.in
        &nbsp;&nbsp;|&nbsp;&nbsp;

        <b>Check Result:</b>
        stcolumbusekdara.in/check/result
    </div>
</section>

</div>

<% if (showNavigation !== false) { %>

    <a
        <% if (student.roll > 1) { %>

            href="/marksheet/print/result/search?class=<%= student.class %>&roll=<%= student.roll - 1 %>&admissionNumber=<%= student.admissionNumber || '' %>"

        <% } %>
    >
        Previous Roll
    </a>


    <a
        href="/marksheet/print/result/search?class=<%= student.class %>&roll=<%= student.roll + 1 %>&admissionNumber=<%= student.admissionNumber || '' %>"
    >
        Next Roll
    </a>

<% } %>


</body>
</html>