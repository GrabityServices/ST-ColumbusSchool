<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title><%= assessmentType==='attendance'?'Attendance Entry':'Scholastic Area Entry' %></title>
<style>
*{box-sizing:border-box}:root{--primary:#155eef;--dark:#172033;--muted:#667085;--border:#e4e7ec;--bg:#f5f7fa;--soft:#eef4ff}
body{margin:0;background:var(--bg);color:var(--dark);font-family:Arial,Helvetica,sans-serif;padding-bottom:70px}.container{max-width:1280px;margin:auto;padding:10px}.card{background:#fff;border:1px solid var(--border);border-radius:14px;box-shadow:0 8px 25px rgba(16,24,40,.07);overflow:hidden}.header{padding:14px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.kicker{color:#1558b0;font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}h1{margin:4px 0;font-size:19px}.meta{color:var(--muted);font-size:10px}.stats{display:inline-flex;margin-top:6px;padding:4px 8px;border-radius:999px;background:#edf4ff;color:#1558b0;font-size:10px;font-weight:800}.header-right{display:flex;gap:7px;flex-wrap:wrap}.badge{padding:7px 9px;border:1px solid var(--border);background:#fafbfc;border-radius:8px;font-size:10px;font-weight:800}.tools{padding:9px 12px;border-bottom:1px solid var(--border);display:flex;gap:7px;align-items:center;flex-wrap:wrap}.search{flex:1;min-width:190px;height:37px;padding:0 10px;border:1px solid #cfd4dc;border-radius:8px;font-size:12px}.select{height:37px;padding:0 9px;min-width:140px;border:1px solid #cfd4dc;border-radius:8px;background:#fff;font-size:11px;font-weight:700}.table-wrap{overflow:auto;max-height:calc(100vh - 230px);-webkit-overflow-scrolling:touch}table{width:100%;min-width:<%= assessmentType==='attendance'?'850px':'1250px' %>;border-collapse:separate;border-spacing:0}th,td{padding:7px 8px;border-bottom:1px solid #eaecf0;white-space:nowrap}th{position:sticky;top:0;z-index:5;background:#f8f9fb;color:#475467;font-size:9px;font-weight:800;text-align:left}td{font-size:10px}.roll{width:55px;text-align:center}.section-cell{width:65px;text-align:center}.name{min-width:190px;font-weight:700}.admission{min-width:110px;color:#475467}.field-cell{min-width:95px;text-align:center}.field-head{min-width:95px;white-space:normal;line-height:1.25;text-align:center}.section-row td{padding:6px 9px;background:linear-gradient(90deg,#e8f1ff,#f7f9ff,#fff);color:#174ea6;border-top:1px solid #cdddf8;border-bottom:1px solid #cdddf8;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.section-badge{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:21px;padding:0 7px;margin-right:6px;border-radius:999px;background:#1769e0;color:#fff}.section-pill{display:inline-flex;min-width:24px;height:21px;padding:0 7px;align-items:center;justify-content:center;border-radius:999px;background:#edf4ff;color:#174ea6;font-size:9px;font-weight:900}.value-input{width:100%;height:31px;border:1px solid #b8c0ca;border-radius:7px;padding:0 6px;text-align:center;font-size:13px;font-weight:700;background:#fff}.value-input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(21,94,239,.1)}.value-input.saved{background:#f5f9ff;border-color:#a7c5ed}.att-input{width:82px}.empty{padding:35px;text-align:center;color:var(--muted)}.note{margin:9px 12px;padding:9px 11px;background:#fff8f8;border:1px solid #ead0d2;border-radius:8px;color:#7d161c;font-size:9px;line-height:1.5}.message{display:none;margin:9px 12px;padding:9px 11px;border-radius:8px;font-size:10px}.message.error{display:block;background:#fff1f2;color:#b42318;border:1px solid #fecdd3}.bottom{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;gap:6px;padding:7px max(7px,calc((100vw - 1280px)/2 + 10px));background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-top:1px solid var(--border)}.bottom a,.bottom button{min-width:110px;height:40px;display:flex;align-items:center;justify-content:center;padding:0 12px;border:1px solid var(--border);border-radius:8px;text-decoration:none;background:#fff;color:#344054;font-size:10px;font-weight:800;cursor:pointer}.bottom .save{border-color:transparent;background:#155eef;color:#fff}.bottom .save:disabled{opacity:.55;cursor:not-allowed}.back{margin-left:auto}@media(max-width:700px){body{padding-bottom:62px}.container{padding:5px}.header{padding:11px}h1{font-size:16px}.tools{padding:6px}.search{min-width:150px;height:34px;font-size:10px}.select{height:34px;min-width:115px;font-size:9px}.table-wrap{max-height:calc(100vh - 255px)}th,td{padding:6px}.name{min-width:160px}.value-input{height:29px;font-size:12px}.bottom{padding:5px}.bottom a,.bottom button{min-width:0;flex:1;height:37px;padding:0 5px;font-size:9px}.back{margin-left:0}}
</style>
</head>
<body>
<div class="container"><div class="card">
<div class="header"><div><div class="kicker">Bulk Schoolist Entry</div><h1><%= classLabel %> · <%= termLabel %> · <%= assessmentType==='attendance'?'Attendance':'Scholastic Area' %></h1><div class="meta">Blank = no change · Student details are read-only</div><div class="stats" id="counter">0 entered</div></div><div class="header-right"><div class="badge"><%= totalStudents %> Students</div><div class="badge"><%= assessmentType==='attendance'?'Attendance':'12 Scholastic Areas' %></div></div></div>
<div class="tools"><input id="search" class="search" type="search" placeholder="Search name, roll, admission or section..." autocomplete="off"><select id="sortBy" class="select"><option value="sectionRoll">Section + Roll</option><option value="roll">Roll within Section</option><option value="name">Name within Section</option><option value="admission">Admission within Section</option></select><select id="sectionFilter" class="select"><option value="ALL">All Sections</option></select></div>
<form method="POST" action="/marksheet/schoolist-clean/save" id="saveForm">
<input type="hidden" name="className" value="<%= className %>"><input type="hidden" name="term" value="<%= term %>"><input type="hidden" name="assessmentType" value="<%= assessmentType %>"><input type="hidden" name="academicYear" value="<%= academicYear %>"><input type="hidden" name="rowsJson" id="rowsJson">
<% if(!students.length){ %><div class="empty">No students found for <strong><%= classLabel %></strong>.</div><% } else { %>
<div class="table-wrap"><table id="studentTable"><thead><tr><th class="roll">#</th><th class="section-cell">SECTION</th><th class="roll">ROLL</th><th class="name">STUDENT NAME</th><th class="admission">ADMISSION NO.</th><% fields.forEach(field=>{ %><th class="field-head"><%= field.label %></th><% }) %></tr></thead><tbody id="studentBody">
<% let currentSection='__START__'; students.forEach((student,index)=>{ if(student.section!==currentSection){ currentSection=student.section; %><tr class="section-row" data-section-row="<%= student.section || 'NO SECTION' %>"><td colspan="<%= 5 + fields.length %>"><span class="section-badge"><%= student.section || '-' %></span><%= student.section ? 'Section '+student.section : 'No Section' %></td></tr><% } %>
<tr class="student-row" data-admission="<%= student.admissionNumber %>" data-name="<%= student.name %>" data-roll="<%= student.rollNumber %>" data-section="<%= student.section %>"><td class="roll"><%= index+1 %></td><td class="section-cell"><span class="section-pill"><%= student.section || '-' %></span></td><td class="roll"><%= student.rollNumber || '-' %></td><td class="name"><%= student.name || '—' %></td><td class="admission"><%= student.admissionNumber %></td><% fields.forEach(field=>{ %><td class="field-cell"><input class="value-input <%= student.values[field.key]!==''?'saved':'' %>" type="<%= assessmentType==='attendance'?'number':'text' %>" <%= assessmentType==='attendance'?'min="0" step="1"':'maxlength="50"' %> data-key="<%= field.key %>" value="<%= student.values[field.key] %>" autocomplete="off"></td><% }) %></tr>
<% }) %></tbody></table></div>
<div class="note"><strong>Save method:</strong> the page sends one JSON payload for the complete table, so it does not create thousands of Express request parameters. The server reloads students from <code>studentlist</code>, builds <code>updateOne</code> operations and saves them with one MongoDB <code>bulkWrite()</code>. Blank values are ignored.</div>
<% } %>
</form>
</div></div>
<div class="bottom"><a href="/marksheet/schoolist-clean">New Entry</a><button type="button" onclick="history.back()">Back</button><button type="submit" form="saveForm" class="save" id="saveButton" <%= !students.length?'disabled':'' %>>Save All</button></div>
<script>
const table=document.getElementById('studentTable');const rows=[...document.querySelectorAll('.student-row')];const search=document.getElementById('search');const sectionFilter=document.getElementById('sectionFilter');const sortBy=document.getElementById('sortBy');const counter=document.getElementById('counter');const form=document.getElementById('saveForm');const rowsJson=document.getElementById('rowsJson');const saveButton=document.getElementById('saveButton');
const sectionValues=[...new Set(rows.map(r=>r.dataset.section).filter(Boolean))].sort((a,b)=>a.localeCompare(b,undefined,{numeric:true,sensitivity:'base'}));sectionValues.forEach(s=>{const o=document.createElement('option');o.value=s;o.textContent='Section '+s;sectionFilter.appendChild(o)});
function valueFor(row,key){return row.querySelector('[data-key="'+CSS.escape(key)+'"]')?.value ?? ''}
function collectRows(){return rows.map(row=>{const item={admissionNumber:row.dataset.admission};row.querySelectorAll('[data-key]').forEach(input=>{item[input.dataset.key]=input.value});return item})}
function updateCounter(){let count=0;rows.forEach(row=>row.querySelectorAll('.value-input').forEach(input=>{if(input.value.trim()!=='')count++}));counter.textContent=count+' entered'}
function applyFilter(){const q=search.value.trim().toLowerCase();const sec=sectionFilter.value;rows.forEach(row=>{const text=(row.dataset.name+' '+row.dataset.admission+' '+row.dataset.roll+' '+row.dataset.section).toLowerCase();row.style.display=(!q||text.includes(q))&&(!sec||sec==='ALL'||row.dataset.section===sec)?'':'none'});document.querySelectorAll('.section-row').forEach(group=>{const sec=group.dataset.sectionRow;const has=rows.some(r=>r.dataset.section===(sec==='NO SECTION'?'':sec)&&r.style.display!=='none');group.style.display=has?'':'none'})}
function sortRows(){const body=document.getElementById('studentBody');const type=sortBy.value;const sorted=[...rows].sort((a,b)=>{const sa=a.dataset.section||'~~~~';const sb=b.dataset.section||'~~~~';const sc=sa.localeCompare(sb,undefined,{numeric:true,sensitivity:'base'});if(sc)return sc;let av,bv;if(type==='name'){av=a.dataset.name;bv=b.dataset.name}else if(type==='admission'){av=a.dataset.admission;bv=b.dataset.admission}else{av=Number(a.dataset.roll);bv=Number(b.dataset.roll);if(Number.isFinite(av)&&Number.isFinite(bv)&&av!==bv)return av-bv;av=a.dataset.roll;bv=b.dataset.roll}return String(av).localeCompare(String(bv),undefined,{numeric:true,sensitivity:'base'})});sorted.forEach(r=>body.appendChild(r));applyFilter()}
rows.forEach(row=>row.querySelectorAll('.value-input').forEach(input=>{input.addEventListener('input',()=>{input.classList.toggle('saved',input.value.trim()!=='');updateCounter()})}));search.addEventListener('input',applyFilter);sectionFilter.addEventListener('change',applyFilter);sortBy.addEventListener('change',sortRows);
form.addEventListener('submit',()=>{rowsJson.value=JSON.stringify(collectRows());saveButton.disabled=true;saveButton.textContent='Saving...'});updateCounter();applyFilter();
</script>
</body></html>
