<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Edit Student Marks
    </title>


    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }


        body {

            min-height: 100vh;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background:
                #f4f6f9;

            color:
                #1f2937;

        }


        .container {

            width:
                min(
                    1100px,
                    94%
                );

            margin:
                0 auto;

            padding:
                30px 0;

        }


        /* ==========================================
           HEADER
        ========================================== */

        .header {

            background:
                #ffffff;

            border:
                1px solid #e5e7eb;

            border-radius:
                16px;

            padding:
                22px 25px;

            margin-bottom:
                22px;

            box-shadow:
                0 4px 18px
                rgba(
                    0,
                    0,
                    0,
                    0.06
                );

            display:
                flex;

            justify-content:
                space-between;

            align-items:
                center;

            gap:
                20px;

        }


        .header h1 {

            font-size:
                26px;

            margin-bottom:
                6px;

        }


        .header p {

            color:
                #6b7280;

            font-size:
                14px;

        }


        .admin-badge {

            background:
                #eef2ff;

            border:
                1px solid #c7d2fe;

            color:
                #3730a3;

            padding:
                10px 14px;

            border-radius:
                10px;

            font-size:
                13px;

            font-weight:
                600;

            white-space:
                nowrap;

        }


        /* ==========================================
           NAVIGATION
        ========================================== */

        .cta-grid {

            display:
                grid;

            grid-template-columns:
                repeat(
                    3,
                    1fr
                );

            gap:
                15px;

            margin-bottom:
                25px;

        }


        .cta {

            text-decoration:
                none;

            background:
                #ffffff;

            border:
                1px solid #e5e7eb;

            border-radius:
                14px;

            padding:
                18px;

            color:
                #111827;

            box-shadow:
                0 4px 15px
                rgba(
                    0,
                    0,
                    0,
                    0.05
                );

            transition:
                0.2s ease;

        }


        .cta:hover {

            transform:
                translateY(-2px);

            border-color:
                #4f46e5;

            box-shadow:
                0 8px 22px
                rgba(
                    0,
                    0,
                    0,
                    0.08
                );

        }


        .cta .icon {

            font-size:
                24px;

            margin-bottom:
                8px;

        }


        .cta h3 {

            font-size:
                16px;

            margin-bottom:
                5px;

        }


        .cta p {

            color:
                #6b7280;

            font-size:
                13px;

            line-height:
                1.5;

        }


        /* ==========================================
           SEARCH FORM
        ========================================== */

        .form-card {

            background:
                #ffffff;

            border:
                1px solid #e5e7eb;

            border-radius:
                18px;

            padding:
                28px;

            box-shadow:
                0 5px 22px
                rgba(
                    0,
                    0,
                    0,
                    0.06
                );

        }


        .form-title {

            margin-bottom:
                24px;

        }


        .form-title h2 {

            font-size:
                22px;

            margin-bottom:
                6px;

        }


        .form-title p {

            font-size:
                14px;

            color:
                #6b7280;

            line-height:
                1.5;

        }


        .form-grid {

            display:
                grid;

            grid-template-columns:
                repeat(
                    3,
                    1fr
                );

            gap:
                18px;

        }


        .form-group {

            display:
                flex;

            flex-direction:
                column;

            gap:
                7px;

        }


        label {

            font-size:
                14px;

            font-weight:
                600;

            color:
                #374151;

        }


        .required {

            color:
                #dc2626;

        }


        input,
        select {

            width:
                100%;

            height:
                46px;

            border:
                1px solid #d1d5db;

            border-radius:
                9px;

            padding:
                0 13px;

            font-size:
                15px;

            outline:
                none;

            background:
                #ffffff;

            color:
                #111827;

            transition:
                0.2s ease;

        }


        input:focus,
        select:focus {

            border-color:
                #4f46e5;

            box-shadow:
                0 0 0 3px
                rgba(
                    79,
                    70,
                    229,
                    0.10
                );

        }


        input.input-error {

            border-color:
                #dc2626;

            box-shadow:
                0 0 0 3px
                rgba(
                    220,
                    38,
                    38,
                    0.08
                );

        }


        .field-error {

            min-height:
                17px;

            color:
                #dc2626;

            font-size:
                12px;

            font-weight:
                500;

        }


        .submit-area {

            margin-top:
                25px;

            display:
                flex;

            justify-content:
                flex-end;

            gap:
                12px;

        }


        button {

            border:
                none;

            background:
                #4f46e5;

            color:
                white;

            min-height:
                46px;

            padding:
                0 26px;

            border-radius:
                9px;

            font-size:
                14px;

            font-weight:
                600;

            cursor:
                pointer;

            transition:
                0.2s ease;

        }


        button:hover {

            background:
                #4338ca;

            transform:
                translateY(-1px);

        }


        .info-box {

            margin-top:
                20px;

            padding:
                14px;

            background:
                #f8fafc;

            border:
                1px solid #e2e8f0;

            border-radius:
                10px;

            color:
                #475569;

            font-size:
                13px;

            line-height:
                1.5;

        }


        /* ==========================================
           RESPONSIVE
        ========================================== */

        @media (
            max-width:
            800px
        ) {

            .cta-grid {

                grid-template-columns:
                    1fr;

            }


            .form-grid {

                grid-template-columns:
                    1fr;

            }


            .header {

                align-items:
                    flex-start;

                flex-direction:
                    column;

            }


            .submit-area {

                justify-content:
                    stretch;

            }


            button {

                width:
                    100%;

            }

        }


        @media (
            max-width:
            500px
        ) {

            .container {

                width:
                    92%;

                padding:
                    18px 0;

            }


            .header {

                padding:
                    19px;

            }


            .header h1 {

                font-size:
                    22px;

            }


            .form-card {

                padding:
                    20px;

            }


            .admin-badge {

                width:
                    100%;

                white-space:
                    normal;

            }

        }

    </style>

</head>


<body>


<div class="container">


    <!-- ==========================================
         HEADER
    =========================================== -->

    <header class="header">


        <div>

            <h1>
                Edit Student Marks
            </h1>

            <p>
                Search a student using admission number
                and update marks for a selected examination.
            </p>

        </div>


        <div class="admin-badge">

            Admin :

            <strong>
                <%= admin.uniqId %>
            </strong>

            -

            <%= admin.name %>

        </div>


    </header>



    <!-- ==========================================
         NAVIGATION
    =========================================== -->

    <section class="cta-grid">


        <a
            href="/stcolumbus/jaj/ekdara/admin"
            class="cta"
        >

            <div class="icon">
                Dashboard
            </div>

            <h3>
                Admin Dashboard
            </h3>

            <p>
                Return to the main administration dashboard.
            </p>

        </a>



        <a
            href="/marksheet"
            class="cta"
        >

            <div class="icon">
                Marks
            </div>

            <h3>
                Fill Marks
            </h3>

            <p>
                Enter examination marks for a student.
            </p>

        </a>



        <a
            href="/marksheet/see/classwise/marks"
            class="cta"
        >

            <div class="icon">
                Results
            </div>

            <h3>
                Classwise Marks
            </h3>

            <p>
                View student marks class by class.
            </p>

        </a>


    </section>



    <!-- ==========================================
         SEARCH FORM
    =========================================== -->

    <section class="form-card">


        <div class="form-title">

            <h2>
                Find Student
            </h2>

            <p>
                Select the class and examination,
                then enter the student's 5-digit admission number.
            </p>

        </div>



        <form
            id="searchForm"
            action="/marksheet/edit/search/for"
            method="GET"
        >


            <div class="form-grid">


                <!-- ======================================
                     CLASS
                ======================================= -->

                <div class="form-group">


                    <label for="class">

                        Select Class

                        <span class="required">
                            *
                        </span>

                    </label>


                    <select
                        id="class"
                        name="class"
                        required
                    >


                        <option value="">
                            Select Class
                        </option>


                        <option value="Nursery">
                            Nursery
                        </option>


                        <option value="LKG">
                            LKG
                        </option>


                        <option value="UKG">
                            UKG
                        </option>


                        <option value="1">
                            Class 1
                        </option>


                        <option value="2">
                            Class 2
                        </option>


                        <option value="3">
                            Class 3
                        </option>


                        <option value="4">
                            Class 4
                        </option>


                        <option value="5">
                            Class 5
                        </option>


                        <option value="6">
                            Class 6
                        </option>


                        <option value="7">
                            Class 7
                        </option>


                        <option value="8">
                            Class 8
                        </option>


                    </select>


                </div>



                <!-- ======================================
                     ADMISSION NUMBER
                ======================================= -->

                <div class="form-group">


                    <label for="admissionNumber">

                        Admission Number

                        <span class="required">
                            *
                        </span>

                    </label>


                    <input

                        type="text"

                        id="admissionNumber"

                        name="admissionNumber"

                        placeholder="Enter 5-digit admission number"

                        inputmode="numeric"

                        autocomplete="off"

                        maxlength="5"

                        pattern="[0-9]{5}"

                        required

                    >


                    <div
                        class="field-error"
                        id="admissionNumberError"
                    ></div>


                </div>



                <!-- ======================================
                     EXAM TYPE
                ======================================= -->

                <div class="form-group">


                    <label for="examType">

                        Select Exam Type

                        <span class="required">
                            *
                        </span>

                    </label>


                    <select
                        id="examType"
                        name="examType"
                        required
                    >


                        <option value="">
                            Select Exam
                        </option>


                        <option value="PT1">
                            PT 1
                        </option>


                        <option value="PT2">
                            PT 2
                        </option>


                        <option value="HalfYearly">
                            Half Yearly
                        </option>


                        <option value="PT3">
                            PT 3
                        </option>


                        <option value="PT4">
                            PT 4
                        </option>


                        <option value="Annual">
                            Annual
                        </option>


                    </select>


                </div>


            </div>



            <!-- ==========================================
                 INFORMATION
            =========================================== -->

            <div class="info-box">

                Student marks will be searched using:

                <br><br>

                <strong>
                    Class + Admission Number + Exam Type
                </strong>

                <br><br>

                Roll Number is not used for searching or editing.

            </div>



            <!-- ==========================================
                 SUBMIT
            =========================================== -->

            <div class="submit-area">

                <button
                    type="submit"
                >

                    Search Student

                </button>

            </div>


        </form>


    </section>


</div>



<script>


// ==========================================
// ELEMENTS
// ==========================================

const searchForm =
    document.getElementById(
        "searchForm"
    );


const admissionNumberInput =
    document.getElementById(
        "admissionNumber"
    );


const admissionNumberError =
    document.getElementById(
        "admissionNumberError"
    );



// ==========================================
// ADMISSION NUMBER
//
// ONLY 5 DIGITS
// ==========================================

admissionNumberInput.addEventListener(
    "input",
    function () {


        // Remove everything except numbers

        this.value =
            this.value.replace(
                /\D/g,
                ""
            );


        // Empty

        if (
            this.value === ""
        ) {

            admissionNumberError.textContent =
                "";

            this.classList.remove(
                "input-error"
            );

            return;

        }


        // Not exactly 5 digits

        if (
            !/^[0-9]{5}$/.test(
                this.value
            )
        ) {

            admissionNumberError.textContent =
                "Admission number must contain exactly 5 digits.";

            this.classList.add(
                "input-error"
            );

            return;

        }


        // Valid

        admissionNumberError.textContent =
            "";

        this.classList.remove(
            "input-error"
        );


    }
);



// ==========================================
// FORM SUBMIT
// ==========================================

searchForm.addEventListener(
    "submit",
    function (
        event
    ) {


        const admissionNumber =
            admissionNumberInput.value
                .trim();


        // Validate 5-digit admission number

        if (
            !/^[0-9]{5}$/.test(
                admissionNumber
            )
        ) {

            event.preventDefault();


            admissionNumberError.textContent =
                "Please enter a valid 5-digit admission number.";


            admissionNumberInput.classList.add(
                "input-error"
            );


            admissionNumberInput.focus();


            return;

        }


        // Clean error

        admissionNumberError.textContent =
            "";


        admissionNumberInput.classList.remove(
            "input-error"
        );


        console.log(
            "SEARCHING STUDENT"
        );


        console.log(
            "CLASS:",
            document.getElementById(
                "class"
            ).value
        );


        console.log(
            "ADMISSION NUMBER:",
            admissionNumber
        );


        console.log(
            "EXAM:",
            document.getElementById(
                "examType"
            ).value
        );


    }
);


</script>


</body>

</html>