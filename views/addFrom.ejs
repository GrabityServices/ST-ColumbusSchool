
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Admission Form | St. Columbus Public School</title>
  <meta name="theme-color" content="#f5f8ff">

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" href="/favicon.ico">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary: #2457d6;
      --primary-dark: #1945b5;
      --primary-light: #edf3ff;

      --background: #f5f7fc;
      --surface: #ffffff;

      --text: #17243b;
      --muted: #718096;

      --border: #e5eaf2;
      --success: #16865b;
      --danger: #dc3545;

      --radius: 14px;
      --shadow: 0 12px 40px rgba(24, 48, 90, .07);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--background);
      color: var(--text);
      min-height: 100vh;
      padding: 45px 18px;
      -webkit-font-smoothing: antialiased;
    }

    button, input, select {
      font: inherit;
    }

    .page {
      max-width: 850px;
      margin: auto;
    }

    /* Decorative background */

    .background-decoration {
      position: fixed;
      width: 340px;
      height: 340px;
      border-radius: 50%;
      background: rgba(62, 113, 232, .055);
      filter: blur(2px);
      z-index: -1;
      pointer-events: none;
    }

    .decoration-one {
      top: -130px;
      right: -100px;
    }

    .decoration-two {
      bottom: -180px;
      left: -120px;
    }

    /* Header */

    .header {
      text-align: center;
      margin-bottom: 28px;
    }

    .school-logo {
      width: 68px;
      height: 68px;
      object-fit: contain;
      margin-bottom: 14px;
    }

    .school-name {
      font-size: 21px;
      font-weight: 800;
      letter-spacing: -.6px;
      color: #142c58;
      margin-bottom: 7px;
    }

    .school-location {
      color: var(--muted);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: .3px;
    }

    .session-tag {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: var(--primary-light);
      color: var(--primary);
      border: 1px solid #dce7ff;
      border-radius: 50px;
      padding: 8px 15px;
      font-size: 11px;
      font-weight: 700;
      margin-top: 16px;
    }

    .session-dot {
      height: 7px;
      width: 7px;
      border-radius: 50%;
      background: #2e73ed;
    }

    /* Main Card */

    .form-container {
      background: var(--surface);
      border: 1px solid #e9edf4;
      border-radius: 20px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .form-top {
      padding: 30px 36px 24px;
      border-bottom: 1px solid var(--border);
    }

    .form-top h1 {
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -.8px;
      margin-bottom: 9px;
    }

    .form-top p {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
    }

    .required-note {
      color: var(--muted);
      font-size: 11px;
      margin-top: 13px;
    }

    .required-note span {
      color: var(--danger);
    }

    /* Form Body */

    form {
      padding: 28px 36px 35px;
    }

    .form-section {
      margin-bottom: 30px;
    }

    .section-heading {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }

    .section-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 39px;
      height: 39px;
      flex-shrink: 0;
      background: var(--primary-light);
      color: var(--primary);
      border-radius: 11px;
    }

    .section-icon svg {
      width: 19px;
      height: 19px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .section-heading h2 {
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .section-heading p {
      font-size: 11px;
      color: var(--muted);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 19px 18px;
    }

    .form-group {
      min-width: 0;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #34445e;
      margin-bottom: 8px;
    }

    .required {
      color: var(--danger);
      margin-left: 2px;
    }

    input, select {
      width: 100%;
      height: 46px;
      padding: 0 13px;
      background: #fbfcfe;
      border: 1px solid var(--border);
      border-radius: 9px;
      color: var(--text);
      font-size: 13px;
      outline: none;
      transition: border .2s, box-shadow .2s, background .2s;
    }

    input::placeholder {
      color: #a6afbd;
    }

    input:focus, select:focus {
      border-color: var(--primary);
      background: #fff;
      box-shadow: 0 0 0 3px rgba(36, 87, 214, .10);
    }

    input[readonly] {
      background: #f0f3f8;
      color: #69778b;
      cursor: not-allowed;
    }

    select {
      cursor: pointer;
      color: #52627a;
    }

    .error-msg {
      display: none;
      font-size: 11px;
      color: var(--danger);
      margin-top: 6px;
      line-height: 1.5;
    }

    .form-group.invalid input,
    .form-group.invalid select {
      border-color: var(--danger);
      background: #fffafa;
    }

    .form-group.invalid .error-msg {
      display: block;
      animation: fadeIn .2s ease;
    }

    .form-group.valid input,
    .form-group.valid select {
      border-color: #65b995;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(-3px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Address */

    .address-info {
      padding: 12px 14px;
      border-radius: 9px;
      background: #f4f7fc;
      color: #63738d;
      font-size: 11px;
      line-height: 1.6;
      margin-top: 18px;
    }

    /* Divider */

    .section-divider {
      height: 1px;
      background: var(--border);
      margin-bottom: 28px;
    }

    /* Submit */

    .submit-button {
      width: 100%;
      height: 49px;
      background: var(--primary);
      border: none;
      border-radius: 10px;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: background .2s, transform .2s, box-shadow .2s;
      margin-top: 8px;
    }

    .submit-button:hover {
      background: var(--primary-dark);
      box-shadow: 0 6px 18px rgba(36, 87, 214, .22);
      transform: translateY(-1px);
    }

    .submit-button:active {
      transform: translateY(0);
    }

    .submit-button:disabled {
      opacity: .7;
      cursor: wait;
      transform: none;
    }

    .submit-button svg {
      width: 17px;
      height: 17px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .privacy-note {
      text-align: center;
      color: var(--muted);
      font-size: 10px;
      line-height: 1.6;
      margin-top: 15px;
    }

    /* Footer */

    .footer {
      text-align: center;
      color: var(--muted);
      font-size: 11px;
      margin-top: 23px;
      line-height: 1.8;
    }

    .footer strong {
      color: #34445e;
    }

    /* Mobile */

    @media(max-width: 600px) {
      body {
        padding: 24px 12px;
      }

      .school-logo {
        width: 58px;
        height: 58px;
      }

      .school-name {
        font-size: 18px;
      }

      .form-container {
        border-radius: 14px;
      }

      .form-top {
        padding: 24px 19px 20px;
      }

      .form-top h1 {
        font-size: 22px;
      }

      form {
        padding: 23px 19px 25px;
      }

      .form-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .form-group.full {
        grid-column: auto;
      }

      .form-section {
        margin-bottom: 25px;
      }

      .section-heading {
        margin-bottom: 17px;
      }

      input, select {
        height: 48px;
        font-size: 14px;
      }

      .submit-button {
        height: 51px;
      }
    }

    @media(prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>

  <div class="background-decoration decoration-one"></div>
  <div class="background-decoration decoration-two"></div>

  <main class="page">

    <!-- School Header -->

    <header class="header">

      <img
        src="/school-logo.png"
        alt="School Logo"
        class="school-logo"
        onerror="this.style.display='none'"
      >

      <div class="school-name">
        ST. COLUMBUS PUBLIC SCHOOL
      </div>

      <div class="school-location">
        EKDARA, JHAJHA, JAMUI, BIHAR
      </div>

      <div class="session-tag">
        <span class="session-dot"></span>
        ADMISSION OPEN · SESSION 2027–28
      </div>

    </header>

    <!-- Admission Card -->

    <div class="form-container">

      <div class="form-top">

        <h1>Admission Form</h1>

        <p>
          Welcome! Please fill in the details below to apply
          for admission. Ensure all information is correct
          before submitting.
        </p>

        <div class="required-note">
          Fields marked with <span>*</span> are mandatory.
        </div>

      </div>

      <form
        action="/admission/form"
        method="POST"
        id="admissionForm"
        novalidate
      >

        <!-- Student Details -->

        <section class="form-section">

          <div class="section-heading">

            <div class="section-icon">
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="4"></circle>
                <path d="M5 21v-2a7 7 0 0 1 14 0v2"></path>
              </svg>
            </div>

            <div>
              <h2>Student Details</h2>
              <p>Basic information about the student</p>
            </div>

          </div>

          <div class="form-grid">

            <div class="form-group">
              <label for="name">
                Student's full name <span class="required">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Enter student's full name"
                autocomplete="name"
                maxlength="60"
                required
              >
              <div class="error-msg"></div>
            </div>

            <div class="form-group">
              <label for="age">
                Age <span class="required">*</span>
              </label>
              <input
                type="number"
                id="age"
                name="age"
                placeholder="Enter age in years"
                min="3"
                max="100"
                step="1"
                required
              >
              <div class="error-msg"></div>
            </div>

            <div class="form-group full">
              <label for="email">
                Email address <span class="required">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="example@email.com"
                autocomplete="email"
                required
              >
              <div class="error-msg"></div>
            </div>

          </div>

        </section>

        <div class="section-divider"></div>

        <!-- Parent Details -->

        <section class="form-section">

          <div class="section-heading">

            <div class="section-icon">
              <svg viewBox="0 0 24 24">
                <circle cx="9" cy="8" r="3.5"></circle>
                <path d="M2 21v-2a7 7 0 0 1 14 0v2"></path>
                <path d="M16 5.5a3.5 3.5 0 0 1 0 6.8"></path>
                <path d="M19 15a6 6 0 0 1 3 5"></path>
              </svg>
            </div>

            <div>
              <h2>Parent / Guardian Details</h2>
              <p>Contact and family information</p>
            </div>

          </div>

          <div class="form-grid">

            <div class="form-group">
              <label for="fname">
                Father's name <span class="required">*</span>
              </label>
              <input
                type="text"
                id="fname"
                name="fname"
                placeholder="Enter father's name"
                maxlength="60"
                required
              >
              <div class="error-msg"></div>
            </div>

            <div class="form-group">
              <label for="mobNumber">
                Father's mobile number <span class="required">*</span>
              </label>
              <input
                type="tel"
                id="mobNumber"
                name="mobNumber"
                placeholder="10-digit mobile number"
                inputmode="numeric"
                maxlength="10"
                autocomplete="tel"
                required
              >
              <div class="error-msg"></div>
            </div>

            <div class="form-group full">
              <label for="mname">
                Mother's name <span class="required">*</span>
              </label>
              <input
                type="text"
                id="mname"
                name="mname"
                placeholder="Enter mother's name"
                maxlength="60"
                required
              >
              <div class="error-msg"></div>
            </div>

          </div>

        </section>

        <div class="section-divider"></div>

        <!-- Address -->

        <section class="form-section">

          <div class="section-heading">

            <div class="section-icon">
              <svg viewBox="0 0 24 24">
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
              </svg>
            </div>

            <div>
              <h2>Residential Address</h2>
              <p>Where does the student currently live?</p>
            </div>

          </div>

          <div class="form-grid">

            <div class="form-group">
              <label for="vill">
                Village <span class="required">*</span>
              </label>
              <input
                type="text"
                id="vill"
                name="addv"
                placeholder="Enter village name"
                required
              >
              <div class="error-msg"></div>
            </div>

            <div class="form-group">
              <label for="town">
                Town / Post Office <span class="required">*</span>
              </label>
              <input
                type="text"
                id="town"
                name="addt"
                placeholder="Enter town or post office"
                required
              >
              <div class="error-msg"></div>
            </div>

            <div class="form-group">
              <label for="dist">District <span class="required">*</span></label>
              <input
                type="text"
                id="dist"
                name="addd"
                required
              >
            </div>

            <div class="form-group">
              <label for="state">State <span class="required">*</span></label>
              <input
                type="text"
                id="state"
                name="adds"
                required
              >
            </div>

            <div class="form-group">
              <label for="pincode">Pincode <span class="required">*</span></label>
              <input
                type="text"
                id="pincode"
                name="addp"
                required
              >
            </div>

          </div>

        

        </section>

        <div class="section-divider"></div>

        <!-- Admission Details -->

        <section class="form-section">

          <div class="section-heading">

            <div class="section-icon">
              <svg viewBox="0 0 24 24">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path>
                <path d="M8 7h8M8 11h8"></path>
              </svg>
            </div>

            <div>
              <h2>Admission Details</h2>
              <p>Select the class for which admission is requested</p>
            </div>

          </div>

          <div class="form-grid">

            <div class="form-group full">

              <label for="forClass">
                Applying for class <span class="required">*</span>
              </label>

              <select id="forClass" name="forClass" required>

                <option value="">Choose your preferred class</option>
                <option value="NUR">Nursery</option>
                <option value="LKG">LKG</option>
                <option value="UKG">UKG</option>
                <option value="1ST">Class 1</option>
                <option value="2ND">Class 2</option>
                <option value="3RD">Class 3</option>
                <option value="4TH">Class 4</option>
                <option value="5TH">Class 5</option>
                <option value="6TH">Class 6</option>
                <option value="7TH">Class 7</option>
                <option value="8TH">Class 8</option>
                <option value="9TH">Class 9</option>
                <option value="10TH">Class 10</option>

              </select>

              <div class="error-msg"></div>

            </div>

          </div>

        </section>

        <!-- Submit -->

        <button type="submit" class="submit-button" id="submitButton">

          <span>Submit Admission Application</span>

          <svg viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>

        </button>

        <div class="privacy-note">
          Please verify all information before submitting your application.
        </div>

      </form>

    </div>

    <!-- Footer -->

    <footer class="footer">
      <strong>ST. COLUMBUS PUBLIC SCHOOL</strong><br>
      Ekdara, Jhajha, Jamui, Bihar<br>
      Academic Session 2027–28
    </footer>

  </main>

  <script>

    const form = document.getElementById('admissionForm');
    const submitButton = document.getElementById('submitButton');

    // Validation rules

    const nameRegex = /^[\p{L}\s.'-]{2,60}$/u;
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    const phoneRegex = /^[6-9]\d{9}$/;

    function setError(input, message) {

      const group = input.closest('.form-group');

      group.classList.remove('valid');
      group.classList.add('invalid');

      group.querySelector('.error-msg').textContent = message;

      input.setAttribute('aria-invalid', 'true');

    }

    function clearError(input) {

      const group = input.closest('.form-group');

      group.classList.remove('invalid');
      group.classList.remove('valid');

      group.querySelector('.error-msg').textContent = '';

      input.removeAttribute('aria-invalid');

    }

    function validateInput(input) {

      const value = input.value.trim();

      clearError(input);

      if (input.hasAttribute('required') && !value) {
        setError(input, 'This field is required.');
        return false;
      }

      if (!value) return true;

      switch (input.id) {

        case 'name':
          if (!nameRegex.test(value)) {
            setError(input, 'Enter a valid student name.');
            return false;
          }
          break;

        case 'fname':
          if (!nameRegex.test(value)) {
            setError(input, 'Enter a valid father\'s name.');
            return false;
          }
          break;

        case 'mname':
          if (!nameRegex.test(value)) {
            setError(input, 'Enter a valid mother\'s name.');
            return false;
          }
          break;

        case 'age': {
          const age = Number(value);

          if (!Number.isInteger(age) || age < 3 || age > 100) {
            setError(input, 'Age must be a whole number between 3 and 100.');
            return false;
          }
          break;
        }

        case 'email':
          if (!emailRegex.test(value)) {
            setError(input, 'Please enter a valid email address.');
            return false;
          }
          break;

        case 'mobNumber':
          if (!phoneRegex.test(value)) {
            setError(input, 'Enter a valid 10-digit Indian mobile number.');
            return false;
          }
          break;

        case 'forClass':
          if (!value) {
            setError(input, 'Please select a class.');
            return false;
          }
          break;

      }

      input.closest('.form-group').classList.add('valid');

      return true;
    }

    // Live validation

    form.querySelectorAll('input:not([readonly]), select').forEach(input => {

      input.addEventListener('blur', () => {
        validateInput(input);
      });

      input.addEventListener('input', () => {

        if (input.closest('.form-group').classList.contains('invalid')) {
          validateInput(input);
        }

      });

      input.addEventListener('change', () => {
        if (input.closest('.form-group').classList.contains('invalid')) {
          validateInput(input);
        }
      });

    });

    // Only allow digits in mobile number

    document.getElementById('mobNumber').addEventListener('input', function() {
      this.value = this.value.replace(/\D/g, '').slice(0, 10);
    });

    // Form submission

    form.addEventListener('submit', function(event) {

      let isValid = true;
      let firstInvalid = null;

      const inputs = form.querySelectorAll(
        'input:not([readonly]), select'
      );

      inputs.forEach(input => {

        if (!validateInput(input)) {

          isValid = false;

          if (!firstInvalid) {
            firstInvalid = input;
          }

        }

      });

      if (!isValid) {

        event.preventDefault();

        firstInvalid.focus();

        return;

      }

      // Prevent accidental double submission

      submitButton.disabled = true;

      submitButton.querySelector('span').textContent = 'Submitting...';

    });

  </script>

</body>
</html>
