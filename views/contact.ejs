  <!-- CONTACT PAGE SCHEMA -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [

      {
        "@type": "WebSite",
        "@id": "https://www.stcolumbusekdara.cloud/#website",
