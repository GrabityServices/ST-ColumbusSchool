        "name": "St. Columbus Public School",
        "url": "https://www.stcolumbusekdara.cloud/",
        "logo": "https://www.stcolumbusekdara.cloud/images/logo.png",
        "telephone": "+918541083858",
        "email": "st.columbus2002@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Ekdara",
          "addressLocality": "Jhajha",
          "addressRegion": "Bihar",
          "postalCode": "811308",
          "addressCountry": "IN"
        },
        "sameAs": [
          "https://www.facebook.com/share/1H5Z3RhMEb/",
          "https://www.instagram.com/columbusschooljhajha",
          "https://www.youtube.com/@DilipKumar-rf4rx/videos",
          "https://x.com/stcolumbus2002"
        ]
      },

      {
        "@type": "ContactPage",
        "@id": "https://www.stcolumbusekdara.cloud/contact#contactpage",
        "url": "https://www.stcolumbusekdara.cloud/contact",
        "name": "Contact Us | St. Columbus Public School",
        "description": "Get in touch with St. Columbus Public School, Ekdara (Jhajha). Contact us for admission inquiries, school information, or support.",
        "inLanguage": "en-IN",
        "isPartOf": { "@id": "https://www.stcolumbusekdara.cloud/#website" },
        "about": { "@id": "https://www.stcolumbusekdara.cloud/#school" }
      },

      {
        "@type": "BreadcrumbList",
        "@id": "https://www.stcolumbusekdara.cloud/contact#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://www.stcolumbusekdara.cloud/"
          },
          {
            "@type": "ListItem",
