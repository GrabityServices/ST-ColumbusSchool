        </button>

        <span class="sidebar-group-label">SCHOOL OPERATIONS</span>
        <button class="admin-tab-button" id="tab-admission" type="button"
          role="tab" aria-selected="false" aria-controls="panel-admission" data-tab="admission">
          <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i><span>Admissions</span>
        </button>
        <button class="admin-tab-button" id="tab-exams" type="button"
          role="tab" aria-selected="false" aria-controls="panel-exams" data-tab="exams">
          <i class="fa-solid fa-file-circle-check" aria-hidden="true"></i><span>Exam &amp; Results</span>
        </button>

        <span class="sidebar-group-label">SYSTEM</span>
        <button class="admin-tab-button" id="tab-admins" type="button"
          role="tab" aria-selected="false" aria-controls="panel-admins" data-tab="admins">
          <i class="fa-solid fa-users-gear" aria-hidden="true"></i><span>Admin Accounts</span>
        </button>
      </nav>

   <%
  const loggedInAdmin = Array.isArray(data)
    ? data.find(admin =>
        String(admin.uniqId) === String(jwtData?.uniqId)
      )
    : null;
%>

<div class="sidebar-footer sidebar-account">
  <% if (loggedInAdmin) { %>

    <div class="sidebar-account-info">

      <div class="sidebar-account-avatar">
        <% if (loggedInAdmin.img) { %>
          <img
            src="<%= loggedInAdmin.img %>"
            alt="<%= loggedInAdmin.name %>"
          >
        <% } else { %>
          <i class="fa-solid fa-user"></i>
        <% } %>
      </div>

      <div class="sidebar-account-text">
        <strong title="<%= loggedInAdmin.name %>">
          <%= loggedInAdmin.name %>
        </strong>

        <span>ID: <%= loggedInAdmin.uniqId %></span>

        <small>
          <%= (jwtData.role || (supAd ? 'superadmin' : 'editor')).toUpperCase() %>
        </small>
      </div>

    </div>

  <% } else { %>

    <div class="sidebar-account-info">
      <div class="sidebar-account-avatar">
        <i class="fa-solid fa-user"></i>
      </div>

      <div class="sidebar-account-text">
        <strong><%= jwtData?.name || 'Admin session' %></strong>
        <span>Account details unavailable</span>
      </div>
    </div>

  <% } %>

  <button
    id="logout-btn"
    class="sidebar-logout-btn"
    type="button"
    title="Log out"
    aria-label="Log out"
  >
    <i class="fa-solid fa-right-from-bracket"></i>
  </button>
</div>
    </aside>

    <main class="admin-main">
      <section class="admin-tab-panel overview-panel is-active" id="panel-overview"
        role="tabpanel" aria-labelledby="tab-overview" data-panel="overview">
        <div class="overview-welcome">
          <div>
            <span class="section-kicker">OVERVIEW</span>
            <h2>Welcome to your dashboard</h2>
            <p>Manage school website content from one organised workspace.</p>
          </div>
          <span class="overview-live"><span></span> Workspace ready</span>
        </div>

        <div class="overview-stat-grid">
          <button class="overview-stat" type="button" data-go-tab="admins">
            <span class="stat-icon stat-blue"><i class="fa-solid fa-users-gear"></i></span>
            <strong><%= Array.isArray(data) ? data.length : 0 %></strong>
            <span>Admin accounts</span><small>Open section <i class="fa-solid fa-arrow-right"></i></small>
          </button>
          <button class="overview-stat" type="button" data-go-tab="leadership">
            <span class="stat-icon stat-purple"><i class="fa-solid fa-user-tie"></i></span>
            <strong><%= Array.isArray(admins) ? admins.length : 0 %></strong>
            <span>Leadership profiles</span><small>Open section <i class="fa-solid fa-arrow-right"></i></small>
          </button>
          <button class="overview-stat" type="button" data-go-tab="gallery">
            <span class="stat-icon stat-green"><i class="fa-regular fa-images"></i></span>
            <strong><%= Array.isArray(images) ? images.reduce((total, group) => total + (Array.isArray(group) ? group.reduce((n, titleGroup) => n + (Array.isArray(titleGroup) ? titleGroup.length : 0), 0) : 0), 0) : 0 %></strong>
            <span>Gallery images</span><small>Open section <i class="fa-solid fa-arrow-right"></i></small>
          </button>
          <button class="overview-stat" type="button" data-go-tab="notices">
            <span class="stat-icon stat-orange"><i class="fa-regular fa-bell"></i></span>
            <strong><%= Array.isArray(notices) ? notices.length : 0 %></strong>
            <span>Notices</span><small>Open section <i class="fa-solid fa-arrow-right"></i></small>
          </button>
          <button class="overview-stat" type="button" data-go-tab="videos">
            <span class="stat-icon stat-cyan"><i class="fa-solid fa-film"></i></span>
            <strong><%= Array.isArray(videoEmbed) ? videoEmbed.length : 0 %></strong>
            <span>Video embeds</span><small>Open section <i class="fa-solid fa-arrow-right"></i></small>
          </button>
          <button class="overview-stat" type="button" data-go-tab="admission">
            <span class="stat-icon stat-red"><i class="fa-solid fa-graduation-cap"></i></span>
            <strong><i class="fa-solid fa-arrow-up-right-from-square"></i></strong>
            <span>Admission tools</span><small>Open section <i class="fa-solid fa-arrow-right"></i></small>
          </button>
        </div>

<!-- DATABASE EXPORT SHORTCUTS -->

<div class="overview-stat-grid">

  <a
    class="overview-stat"
    href="/data/admin/export"
    style="text-decoration:none;"
  >
    <span class="stat-icon stat-blue">
      <i class="fa-solid fa-database"></i>
    </span>

    <strong>Database</strong>

    <span>Export Collections</span>

    <small>
      CSV, JSON & Complete ZIP
      <i class="fa-solid fa-arrow-right"></i>
    </small>

  </a>


  <a
    class="overview-stat"
    href="/data/admin/export/assets"
    style="text-decoration:none;"
  >
    <span class="stat-icon stat-green">
      <i class="fa-solid fa-folder-closed"></i>
    </span>

    <strong>Assets ZIP</strong>

    <span>Website Files Backup</span>

    <small>
      Download All Assets
      <i class="fa-solid fa-download"></i>
    </small>

  </a>

</div>

<!-- DATABASE BACKUP MONITOR -->

<div
  class="backup-monitor"
  id="backupMonitor"
>

  <div class="backup-monitor-header">

    <h3>
      <i class="fa-solid fa-shield-halved"></i>
      Database Backup Monitor
    </h3>

    <span
      class="backup-status-label"
      id="backupStatusLabel"
    >
      <span class="backup-status-dot"></span>
      Checking...
    </span>

  </div>

  <p
    class="backup-monitor-message"
    id="backupStatusMessage"
  >
    Checking your latest complete database backup...
  </p>

  <div class="backup-monitor-meta">

    <span id="backupLastDate">
      Last backup: Checking...
    </span>

    <span id="backupAge">
      Backup age: --
    </span>

  </div>

  <a
    href="/data/admin/export"
    class="backup-monitor-action"
  >
    <i class="fa-solid fa-download"></i>
    Export Database Now
  </a>

</div>

        <div class="overview-help-card">
          <div class="help-icon"><i class="fa-regular fa-lightbulb"></i></div>
          <div>
            <h3>Quick tip</h3>
            <p>Use the left navigation to switch between content areas. Your existing edit, upload, delete and management links remain available inside their respective sections.</p>
          </div>
        </div>
      </section>
    <!-- FIRST SECTION -->
    <section class="first-section admin-tab-panel" id="panel-admins" role="tabpanel" aria-labelledby="tab-admins" data-panel="admins" hidden>
      <h2>Admins Accounts</h2>
      <div class="card-container">
      <% if (!Array.isArray(data) || data.length === 0) { %>
        <p>No admins found.</p>
        <% } else { %> <% data.forEach(admin=> { %>
        <div class="admin-card">
          <img  src="<%= admin.img %>" alt="<%= admin.name %>'s avatar" />
          <div class="admin-details">
            <p><strong>Name:</strong><%= admin.name %></p>
            <p><strong>Email:</strong><%= admin.email %></p>
            <p><strong>Unique ID:</strong><%= admin.uniqId %></p>
            <p><strong>Role :</strong><%= admin.role.toUpperCase() %></p>
            <p><strong>Blocked:</strong><%= admin.blocked ? "Yes" : "No" %></p>
            <p><strong>Last Login:</strong><%= admin.lastLogin %></p>
          </div>
          <div class="btns">
            <% if(supAd) {%> <% if(admin.role=="superadmin" ){%>
              <button type="submit"onclick="location.href='/stcolumbus/jaj/ekdara/admin/update/img/<%= admin._id %>'" style="display: <%= admin.uniqId === '1111D' ? 'none' : '' %>" class="link-btn">Update Img</button>
              <button type="submit" onclick="location.href='/stcolumbus/jaj/ekdara/admin/update/det/<%= admin._id %>'" style="display: <%= admin.uniqId === '1111D' ? 'none' : '' %>" class="link-btn">Update Details</button>

            <% } %> <%
             if(admsc>1&& admin.role!="superadmin" ) {%>

             <button
             style="display: <%= admin.uniqId === '1111D' ? 'none' : '' %>"
    type="button"
    onclick="location.href='/stcolumbus/jaj/ekdara/admin/delete/<%= admin._id %>'"
    class="link-btn"
>
    Delete Admin
</button>
              <button type="submit" style="display: <%= admin.uniqId === '1111D' ? 'none' : '' %>" onclick="location.href='/stcolumbus/jaj/ekdara/admin/update/det/superadmin/<%= admin._id %>'"class="link-btn">Update Access Control Or Block Admin</button>
            <% }else if(superAdminCount>1){%>
              <button type="submit" style="display: <%= admin.uniqId === '1111D' ? 'none' : '' %>" onclick="location.href='/stcolumbus/jaj/ekdara/admin/delete/<%= admin._id %>'" class="link-btn">Delete Admin</button>
              <button type="submit" style="display: <%= admin.uniqId === '1111D' ? 'none' : '' %>" onclick="location.href='/stcolumbus/jaj/ekdara/admin/update/det/superadmin/<%= admin._id %>'" class="link-btn">Update Access Control Or Block Admin</button>
            <%} %> <% }else{%>
              <button type="submit" onclick="location.href='/stcolumbus/jaj/ekdara/admin/update/img/<%= admin._id %>'" class="link-btn">Update Img</button>
              <button type="submit" onclick="location.href='/stcolumbus/jaj/ekdara/admin/update/det/<%= admin._id %>'" class="link-btn">Update Details</button>
              <%} %>
            </div>
          </div>
      <% }) %> <% } %>
      </div>
    </section>

    <!-- SECOND SECTION -->
    <section class="second-section admin-tab-panel" id="panel-leadership" role="tabpanel" aria-labelledby="tab-leadership" data-panel="leadership" hidden>
      <h2>Principal & Director Information</h2>
      <div class="director-principle-container">
        <% if (typeof admins !=='undefined' && admins && admins.length> 0) {%> <% admins.forEach(admin=> { %>
        <ul>
          <li class="school-heads"><img src="<%= admin.img %>" alt="<%= admin.name %>" /></li>
          <div class="inner-dir-and-principle">
              <li><strong>Name: </strong><span><%= admin.name %></span></li>
              <li><strong>Id No: </strong><span><%= admin.unqId %></span></li>
              <li><strong>Email: </strong><span><%= admin.email %></span></li>
              <li><strong>Position: </strong><span><%= admin.position %></span></li>
              <li><strong>Qualification: </strong><span><%= admin.quli %></span></li>
              <li><strong>Age: </strong><span><%= admin.age %></span></li>
              <li><strong>Gender: </strong><span><%= admin.gender %></span></li>
            </div>
            <div class="updated-head-image">
              <%if(!supAd){%>
              <a href="/home/adminUpdate/<%=admin._id %>">Update Img</a>
              <a href="/home/adminUpdate/details/<%=admin._id %>">Update details</a>
              <%} %>
            </div>
          </ul>
          <% }); %> <% } else { %>
          <p>No admins found or admins data is not available.</p>
          <% } %>
        </div>
    </section>

    <!-- THIRD SECTION -->
    <section class="gallery-section admin-tab-panel" id="panel-gallery" role="tabpanel" aria-labelledby="tab-gallery" data-panel="gallery" hidden>
        <div class="galley-section-heading">
          <h2>Gallery Section Images</h2>
          <% if (!supAd && data[0] && data[0].uniqId.charAt(1) === 'E') { %>
          <a class="btn new-event" href="/home/gallery/new"
            >+ Set a new Event <%= data[0].uniqId %></a
          >
          <% } %>
        </div>
        <div class="gallery-header">
          <div class="event">
            <% images.slice().reverse().forEach(eventGroup=> { %>
            <!-- eventGroup = one event date with titles inside -->
            <h1><%= eventGroup[0][0].EventDate %></h1>
            <div class="datesect">
              <% eventGroup.forEach(titleGroup=> { %>
              <!-- titleGroup = one title group inside this event date -->
              <h3><%= titleGroup[0].title %></h3>
              <div class="images">
                <% titleGroup.forEach(item=> { %>
                <div class="img">
                  <img loading="lazy" src="<%= item.img %>" alt="<%= item.title %>" />
                  <% if (!supAd && data[0] && data[0].uniqId.charAt(1) === 'E' ) { %>
                  <a class="btn" href="/home/galleryUpdate/<%= item._id %>">Update Img</a>
                  <a
                    class="btn"
                    href="/home/galleryUpdate/details/<%= item._id %>"
                    >Update details</a
                  >
                  <% if (titleGroup.length> 3) { %>
                  <a
                    class="btn delete"
                    href="/home/galleryDelete/<%= item._id %>"
                    >Delete</a
                  >
                  <% } %> <% } %>
                </div>
                <% }) %> <% if (!supAd && data[0] && data[0].uniqId.charAt(1) === 'E') { %>
                <a
                  class="btn new-event"
                  href="/home/gallery/new?date=<%= eventGroup[0][0].EventDate%>&title=<%= titleGroup[0].title %>"
                  >+ Add Image</a
                >
                <% } %>
              </div>
              <% }) %>
            </div>
            <% }) %>
          </div>
        </div>
    </section>

    <!-- FOURTH PAGE -->
    <section class="fourth-section admin-tab-panel" id="panel-notices" role="tabpanel" aria-labelledby="tab-notices" data-panel="notices" hidden>
        <div class="fourth-section-heading-and-btn">
          <h2>Notices Section</h2>
          <% if (!supAd && data[0] && data[0].uniqId.charAt(1) === 'E') { %>
          <a class="new-notice-btn" href="/home/notice/new">+ New Notice</a>
          <% } %>
        </div>

        <div class="fourth-section-outer">
          <% notices.forEach(notice => { %>
          <div class="fourth-section-card">
            <!-- IMAGE / PDF -->
            <% if (notice.img) { const regex = /\.pdf$/i; if
            (!regex.test(notice.img)) { %>
            <!-- If it's an image -->
            <img loading="lazy" 
              src="<%= notice.img %>"
              alt="<%= notice.title %>"
              class="notice-img"
            />
            <a class="btn" href="<%= notice.img %>" target="_blank" download=""
              >Download</a
            >

            <% if (!supAd && data[0] && data[0].uniqId.charAt(1) === 'E') { %>
            <a class="btn" href="/home/noticeUpdate/<%= notice._id %>">
              <% if (notice.img) { %>Update Image<% } else { %>Add Image | PDF<%
              } %>
            </a>
            <% } %> <% } else { %>
            <!-- If it's a PDF -->
            <iframe
              class="notice-pdf"
              src="<%= notice.img %>"
              frameborder="0"
            ></iframe>
            <a class="btn" href="<%= notice.img %>" target="_blank">Download</a>

            <% if (!supAd && data[0] && data[0].uniqId.charAt(1) === 'E') { %>
            <a class="btn" href="/home/noticeUpdate/<%= notice._id %>">
              <% if (notice.img) { %>Update PDF<% } else { %>Add Image | PDF<% }
              %>
            </a>
            <% } %> <% } } %>

            <!-- SUBJECT -->
            <h3 class="notice-title"><%= notice.title %></h3>

            <!-- NOTICE MESSAGE -->
            <p class="notice-text"><%= notice.mess %></p>

            <!-- ACTION BUTTONS -->
            <% if (!supAd && data[0] && data[0].uniqId.charAt(1) === 'E') { %>
            <div class="btn-group">
              <a class="btn" href="/home/noticeUpdate/details/<%= notice._id %>"
                >Update Details</a
              >
              <a class="btn delete" href="/home/noticeDelete/<%= notice._id %>"
                >Delete</a
              >
            </div>
            <% } %>

            <!-- DATE -->
            <p class="notice-date"><%= notice.messDate %></p>
          </div>
          <% }); %>
        </div>
    </section>

    <!-- FIFTH PAGE -->
    <section class="sixth-section admin-tab-panel" id="panel-videos" role="tabpanel" aria-labelledby="tab-videos" data-panel="videos" hidden>
        <div class="sixth-section-heading">
          <h2>Videos</h2>
          <% if (!supAd && data[0] && data[0].uniqId.charAt(1) === 'E') { %>
          <a class="new-video-btn" href="/home/video/embedded/new">+ New Video Embed Code</a>
          <% } %>
        </div>

        <div class="sixth-section-outer">
          <% videoEmbed.forEach(video => { %>
          <div class="sixth-section-card">
            <!-- VIDEO EMBED CODE -->
            <div class="video-embed"><%- video.videoEmbed %></div>

            <!-- ACTION BUTTONS -->
            <% if (!supAd && data[0] && data[0].uniqId.charAt(1) === 'E') { %>
            <div class="btn-group">
              <a class="btn" href="/home/video/embedded/update/<%= video._id %>"
                >Update Embed Code</a
              >
              <a class="btn delete" href="/home/video/embedded/delete/<%= video._id %>"
                >Delete</a
              >
            </div>
            <% } %>
            <!-- DATE -->
            <p class="video-date">
              Added on: <%= video.updatedAt.toLocaleDateString("en-US", { year:
              'numeric', month: 'long', day: 'numeric' }) %>
            </p>
          </div>
          <% }); %>
        </div>
