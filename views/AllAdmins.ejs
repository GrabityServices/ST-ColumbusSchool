<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>All Admins</title>
  <link rel="stylesheet" href="/style/admin.css" />
  <link rel="stylesheet" href="/style/admin-tabs.css" /> <link rel="stylesheet" href="/style/admin-workspace-enhancements.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script src="/script/admin.js" defer></script>
  <script src="/script/admin-tabs.js" defer></script> 

<style>
/* DATABASE BACKUP INDICATOR */

.backup-monitor {
  margin-top: 24px;
  padding: 20px;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  background: #fff;
}

.backup-monitor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.backup-monitor-header h3 {
  font-size: 16px;
  margin: 0;
}

.backup-status-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 700;
  padding: 7px 11px;
  border-radius: 30px;
}

.backup-status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: currentColor;
}

.backup-monitor.success {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.backup-monitor.success .backup-status-label {
  color: #15803d;
  background: #dcfce7;
}

.backup-monitor.warning {
  border-color: #fde68a;
  background: #fffbeb;
}

.backup-monitor.warning .backup-status-label {
  color: #a16207;
  background: #fef3c7;
}

.backup-monitor.danger {
  border-color: #fecaca;
  background: #fef2f2;
}

.backup-monitor.danger .backup-status-label {
  color: #b91c1c;
  background: #fee2e2;
}

.backup-monitor-message {
  margin-top: 12px;
  font-size: 13px;
  line-height: 1.7;
  color: #555;
}

.backup-monitor-meta {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 13px;
  padding-top: 12px;
  border-top: 1px solid #e5e7eb;
  font-size: 12px;
  color: #777;
}

.backup-monitor-action {
  display: inline-block;
  margin-top: 14px;
  padding: 10px 15px;
  background: #171717;
  color: #fff;
  text-decoration: none;
  border-radius: 7px;
  font-size: 13px;
  font-weight: 600;
}

.backup-monitor-action:hover {
  background: #333;
}

.backup-monitor-loading {
  color: #777;
  font-size: 13px;
  margin-top: 12px;
}
.sidebar-account-avatar {
  width: 42px;
  height: 42px;
  min-width: 42px;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e5e7eb;
}

.sidebar-account-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
</style>


</head>
<body>

  <!-- HEADER -->
  <header class="header">
    <h1 class="page-title"><% if(supAd){%>Admin <%}else{%>Editor <%} %>Dashboard</h1>
    <nav class="header-nav">
      <button onclick="location.href='/'" class="head-btn" title="Open website">
        <i class="fa-solid fa-house"></i><span> Website</span>
      </button>
      <button onclick="location.href='/stcolumbus/admin/manage/change/pass'" class="head-btn" title="Change Password">
        <i class="fa-solid fa-key"></i><span> Change Password</span>
      </button>
    </nav>
  </header>

  <div class="admin-app-layout">
    <aside class="admin-sidebar" aria-label="Admin sections">
      <div class="sidebar-heading">
        <span class="sidebar-eyebrow">MANAGEMENT</span>
      </div>

      <nav class="admin-tab-nav" role="tablist" aria-label="Dashboard sections" aria-orientation="vertical">
        <span class="sidebar-group-label">WORKSPACE</span>
        <button class="admin-tab-button is-active" id="tab-overview" type="button"
          role="tab" aria-selected="true" aria-controls="panel-overview" data-tab="overview">
          <i class="fa-solid fa-grid-2" aria-hidden="true"></i><span>Dashboard</span>
        </button>

        <span class="sidebar-group-label">WEBSITE MANAGEMENT</span>
        <button class="admin-tab-button" id="tab-leadership" type="button"
          role="tab" aria-selected="false" aria-controls="panel-leadership" data-tab="leadership">
          <i class="fa-solid fa-user-tie" aria-hidden="true"></i><span>Leadership</span>
        </button>
        <button class="admin-tab-button" id="tab-gallery" type="button"
          role="tab" aria-selected="false" aria-controls="panel-gallery" data-tab="gallery">
          <i class="fa-regular fa-images" aria-hidden="true"></i><span>Gallery Images</span>
        </button>
        <button class="admin-tab-button" id="tab-notices" type="button"
          role="tab" aria-selected="false" aria-controls="panel-notices" data-tab="notices">
          <i class="fa-regular fa-bell" aria-hidden="true"></i><span>Notices</span>
        </button>
        <button class="admin-tab-button" id="tab-videos" type="button"
          role="tab" aria-selected="false" aria-controls="panel-videos" data-tab="videos">
