<script>

// =====================================================
// LIVE DATABASE BACKUP MONITOR
// =====================================================

async function loadBackupStatus() {

  const monitor = document.getElementById(
    "backupMonitor"
  );

  const label = document.getElementById(
    "backupStatusLabel"
  );

  const message = document.getElementById(
    "backupStatusMessage"
  );

  const lastDate = document.getElementById(
    "backupLastDate"
  );

  const age = document.getElementById(
    "backupAge"
  );

  try {

    const response = await fetch(
      "/data/admin/export/status",
      {
        cache: "no-store",
        credentials: "same-origin"
      }
    );

    if (!response.ok) {
      throw new Error("Unable to fetch backup status");
    }

    const status = await response.json();

    // Update indicator color
    monitor.classList.remove(
      "success",
      "warning",
      "danger"
    );

    monitor.classList.add(status.level);

    // Update title
    label.innerHTML = `
      <span class="backup-status-dot"></span>
      ${status.title}
    `;

    // Update message
    message.textContent = status.message;

    // Update dates
    if (status.lastExport) {

      const date = new Date(status.lastExport);

      lastDate.textContent =
        "Last backup: " +
        date.toLocaleString("en-IN");

      age.textContent =
        "Backup age: " +
        status.days +
        " days";

    } else {

      lastDate.textContent =
        "Last backup: Never";

      age.textContent =
        "Backup age: Unknown";

    }

  } catch (error) {

    console.error(
      "Backup Monitor Error:",
      error
    );

    label.innerHTML = `
      <span class="backup-status-dot"></span>
      Status unavailable
    `;

    message.textContent =
      "Unable to retrieve backup information. Please check your connection.";

    lastDate.textContent =
      "Last backup: Unavailable";

    age.textContent =
      "Backup age: --";

  }

}


// Initial load
loadBackupStatus();

// Refresh every 5 minutes
setInterval(loadBackupStatus, 5 * 60 * 1000);

</script>

